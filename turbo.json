{
  "$schema": "https://turbo.build/schema.json",
  // tsconfig.base.json supplies the compiler options for every package. Without it here, editing
  // it (e.g. turning off `strict`) leaves all 25 lint tasks on a cache hit and tsc never reruns.
  "globalDependencies": ["tsconfig.base.json", "pnpm-workspace.yaml"],
  "tasks": {
    // Transit node. Workspace packages are consumed as SOURCE and have no `build` script, so a
    // `dependsOn: ["^build"]` resolves to nothing and a change in @acorn/node-core would NOT
    // invalidate a dependent's cached lint/test — turbo would serve a stale pass. `topo` has no
    // implementation; it exists purely so lint/test inherit their dependencies' input hashes.
    // Requires an acyclic package graph, which is why the client-core <-> plugin cycles must stay
    // broken.
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build", "topo"],
      // out/** is the Electron main/preload/mcp output and was previously undeclared, so a cache
      // hit restored dist/client without it. (.next/** was never produced by this repo.)
      "outputs": ["dist/**", "out/**"],
      "env": ["MAIN_VITE_GITHUB_CLIENT_ID", "MAIN_VITE_GITHUB_CLIENT_SECRET"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["topo"]
    },
    "test": {
      "dependsOn": ["topo"]
    },
    // The boundary test reads every package off disk rather than importing them, so it has no
    // dependency edges for `topo` to hash — once cached, nothing in the repo could invalidate it
    // and it silently reported a stale pass. Hash the manifests and sources it actually inspects.
    "@acorn/arch-tests#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../{apps,packages,plugins,tools}/*/package.json",
        "../../{apps,packages,plugins,tools}/*/src/**",
        "../../{apps,packages,plugins,tools}/*/test/**",
        "../../{apps,packages,plugins,tools}/*/scripts/**"
      ]
    }
  }
}
