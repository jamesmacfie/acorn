{
  "$schema": "https://turbo.build/schema.json",
  // tsconfig.base.json supplies the compiler options for every package. Without it here, editing
  // it (e.g. turning off `strict`) leaves all 25 lint tasks on a cache hit and tsc never reruns.
  //
  // The three plugins/ files are the same hazard one level down: each plugin's tsconfig, vitest and
  // drizzle config is a one-line re-export of them now, and they sit OUTSIDE every package directory,
  // so nothing in the default input set would hash them.
  //
  // The root manifest and the runtime pin are read by node-core's isolation test, which has no way
  // to name a file above its package. Both change rarely enough that rerunning everything is cheap.
  "globalDependencies": [
    "tsconfig.base.json",
    "pnpm-workspace.yaml",
    "package.json",
    "node-runtime.json",
    "plugins/tsconfig.base.json",
    "plugins/vitest.shared.ts",
    "plugins/drizzle.shared.ts",
    "vitest.browser.setup.ts"
  ],
  // Turborepo's strict env mode hands a task only the variables named here, so the worker cap the
  // root `pnpm test` sets would never reach Vitest without this line. Passed through rather than
  // hashed: the worker count changes how fast a suite runs, not what it checks.
  "globalPassThroughEnv": ["VITEST_MAX_WORKERS"],
  "tasks": {
    // Transit node. Workspace packages are consumed as SOURCE and have no `build` script, so a
    // `dependsOn: ["^build"]` resolves to nothing and a change in @acorn/node-core would NOT
    // invalidate a dependent's cached lint/test — turbo would serve a stale pass. `topo` has no
    // implementation; it exists purely so lint/test inherit their dependencies' input hashes.
    // Requires an acyclic package graph, which is why the client-core <-> plugin cycles must stay
    // broken.
    "topo": {
      "dependsOn": ["^topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/*.spec.tsx"
      ]
    },
    "build": {
      "dependsOn": ["^build", "topo"],
      // dist/** is everything a shell build stages: the renderer, the helper and its service, the
      // injected bridge, and the bundled plugin packages. Declared, or a cache hit restores one of
      // them and not the rest.
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["topo"]
    },
    // agent-cost consumes the published SDK declarations from dist, so a clean checkout must
    // build that workspace dependency before type-checking the plugin.
    "@acorn/plugin-agent-cost#lint": {
      "dependsOn": ["topo", "acorn-plugin-sdk#build"]
    },
    "test": {
      "dependsOn": ["topo"]
    },
    // The same hazard, one package over. client-core's `lint` runs the icon census first
    // (scripts/icon-census.mjs), which scans every app and plugin for literal Lucide names. Plugins
    // are not client-core's dependencies — the cycle is deliberately broken — so `topo` gives it none
    // of their hashes, and a new icon spelled in plugins/ would land on a cache hit with the check
    // never run. Hash what the census reads.
    //
    // A package-specific entry replaces the generic one rather than merging with it, so every entry
    // below restates `dependsOn: ["topo"]` or loses its dependencies' hashes.
    "@acorn/client-core#lint": {
      "dependsOn": ["topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../{apps,packages,plugins}/*/src/**"
      ]
    },
    // The stylesheet suites read plugin and desktop CSS (src/infra/styles/readStyleSheets.ts)
    // and the plugin-frame stylesheet list in desktop's stage script (cssHygiene.test.ts).
    // Cross-package TSX adoption checks live in the uncached architecture suite.
    "@acorn/client-core#test": {
      "dependsOn": ["topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../plugins/*/src/**/*.css",
        "../../apps/desktop/src/**/*.css",
        "../../apps/desktop/scripts/stage.mjs"
      ]
    },
    // Fixtures, a sibling's manifest, a settings component and a published schema, all read by path.
    "@acorn/node-core#test": {
      "dependsOn": ["topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../apps/node/test/__fixtures__/**",
        "../../apps/tui/package.json",
        "../client-core/src/features/settings/plugins/PluginsSettings.tsx",
        "../../docs/schemas/**"
      ]
    },
    "@acorn/plugin-api#test": {
      "dependsOn": ["topo"],
      "inputs": ["$TURBO_DEFAULT$", "../../apps/node/test/__fixtures__/**"]
    },
    "create-acorn-plugin#test": {
      "dependsOn": ["topo"],
      "inputs": ["$TURBO_DEFAULT$", "../plugin-types/acorn-plugin.schema.json"]
    },
    // The loadable-plugin config suite walks plugins/ off disk, including plugins apps/node does
    // not depend on. It imports only configs and reads their package versions.
    "@acorn/node#test": {
      "dependsOn": ["topo"],
      "inputs": ["$TURBO_DEFAULT$", "../../plugins/*/acorn-plugin.config.mjs", "../../plugins/*/package.json"]
    },
    // CI sets ACORN_TUI_WIDE to add the wide layout cases. Strict env mode drops any variable a
    // task does not declare, so without this the wide cases never ran and the two widths shared one
    // cache entry.
    "@acorn/tui#test": {
      "dependsOn": ["topo"],
      "env": ["ACORN_TUI_WIDE"]
    },
    // Never cached. The lifecycle suite spawns apps/node's standalone entry from source, so its
    // inputs are apps/node and everything that imports, and apps/node is not a dependency of the CLI.
    "@acorn/cli#test": {
      "dependsOn": ["topo"],
      "cache": false
    },
    // Never cached. The boundary suite reads every package off disk, and docPaths checks that every
    // path cited in docs/, README.md and AGENTS.md exists anywhere in the repo, so its true input set
    // is the repository. The glob list this replaced missed docs/, so a doc edit served a stale pass.
    "@acorn/arch-tests#test": {
      "cache": false
    }
  }
}
