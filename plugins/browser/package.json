{
  "name": "@acorn/plugin-browser",
  "version": "0.1.0",
  "description": "A browser of the node's own, driven by Playwright, offered to agents as tools.",
  "private": true,
  "type": "module",
  "exports": {
    "./node/index.ts": "./src/node/index.ts",
    "./contract/*": "./src/contract/*",
    "./testkit": "./src/testkit/index.ts"
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "ACORN_BROWSER_SMOKE=1 vitest run driver.smoke"
  },
  "dependencies": {
    "@acorn/plugin-api": "workspace:*",
    "@acorn/protocol": "workspace:*",
    "drizzle-orm": "catalog:",
    "playwright-core": "^1.58.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acorn/node-core": "workspace:*",
    "@types/node": "^26.0.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
