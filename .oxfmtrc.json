{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": false,
  "singleQuote": true,
  // oxfmt falls back to any .editorconfig above the checkout, including one in a home folder. Pin the
  // indent so every machine formats the same way.
  "useTabs": false,
  "tabWidth": 2,
  // Leave template literals that hold GraphQL or CSS alone. Formatting them changes the string.
  "embeddedLanguageFormatting": "off",
  // TypeScript only, so migration SQL and snapshots, JSON, and docs stay as written. oxfmt also skips
  // what .gitignore lists, such as dist. The last entry is generated by the icon census.
  "ignorePatterns": [
    "*",
    "!*/",
    "!*.ts",
    "!*.tsx",
    "!*.mts",
    "!*.cts",
    "packages/protocol/src/appearance/workspaceIconNames.ts"
  ]
}
