  },
  "peerDependencies": {
    "solid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "jsdom": "^30.0.1",
    "solid-js": "catalog:",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.11",
    "zod": "catalog:"
  }
