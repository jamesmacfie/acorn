{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getacorn.dev/schemas/acorn-device.schema.json",
  "title": "acorn device configuration",
  "type": "object",
  "properties": {
    "theme": {
      "description": "The theme, by ID, when the theme doesn't follow the system.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "themeLight": {
      "description": "The theme, by ID, while the system is in light mode.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "themeDark": {
      "description": "The theme, by ID, while the system is in dark mode.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "themeFollowSystem": {
      "description": "Whether the theme follows the system, switching between `themeLight` and `themeDark`.",
      "type": "boolean"
    },
    "style": {
      "description": "The style pack, by ID.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "keybindings": {
      "description": "Shortcuts you changed: a command ID to its chord, such as `meta+shift+k`, or `null` to remove it.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 64
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "railOrder": {
      "description": "The order of the left rail.",
      "type": "object",
      "properties": {
        "pinned": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": "Task IDs pinned to the top of the left rail, in order."
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": "Task IDs in the order you dragged them. Other tasks follow."
        },
        "sources": {
          "description": "Source IDs, in the order you dragged them.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      },
      "required": [
        "pinned",
        "order"
      ],
      "additionalProperties": false
    },
    "leftCollapsed": {
      "description": "Whether the left rail is collapsed.",
      "type": "boolean"
    },
    "workspaceRail": {
      "description": "Whether the workspace rail shows.",
      "type": "boolean"
    },
    "keepNodeRunning": {
      "description": "Desktop only. Whether closing the window keeps this computer's Node running behind a tray icon. While the window is closed, this computer shows no acorn notifications.",
      "type": "boolean"
    },
    "openAtLogin": {
      "description": "Desktop only. Whether acorn opens at login with no window. Takes effect only with `keepNodeRunning`.",
      "type": "boolean"
    },
    "railVisibility": {
      "description": "Whether each source shows in the left rail, keyed `<pluginId>:<sourceId>`. A missing entry uses the source's default.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "exclusiveSlots": {
      "description": "Which plugin draws each part of the window a plugin can replace, by plugin ID. `core` is acorn's own.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "rail.taskList",
          "pane.switcher",
          "rail",
          "topbar"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "plugins": {
      "description": "Plugins to offer for installing. Each shows in the Plugins palette, and nothing installs or is trusted until you say so.",
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "The plugin's ID."
          },
          "source": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "github": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tag": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "github"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "npm": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "npm"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https:\\/\\/.*"
                  }
                },
                "required": [
                  "url"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Where to install it from: `{ github, tag? }`, `{ npm, version? }`, `{ url }` on https, or `{ path }`."
          }
        },
        "required": [
          "id",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": {}
}
