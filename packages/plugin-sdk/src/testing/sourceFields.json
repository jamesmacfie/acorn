      },
      {
        "pointer": "/durationMs",
        "label": "Duration",
        "origin": "declared",
        "display": {
          "kind": "number",
          "unit": "ms"
        }
      },
      {
        "pointer": "/pullRequests",
        "label": "Pull requests",
        "origin": "declared",
        "display": {
          "kind": "number",
          "list": true
        }
      },
      {
        "pointer": "/url",
        "label": "Job URL",
        "origin": "declared",
        "display": {
          "kind": "link",
          "role": "url"
        }
      }
    ]
  },
