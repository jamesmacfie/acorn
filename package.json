{
  "name": "acorn",
  "description": "The acorn monorepo: an agent workspace built as a desktop shell, a Node service, and a tree of plugins.",
  "private": true,
  "packageManager": "pnpm@11.0.0",
  "//engines": "The same floor the packed standalone artifact declares (scripts/pack-node.mjs). Two things need it: the node:sqlite surface the DB shim uses, and apps/node/scripts/build-plugin.mjs importing a .ts file directly, which relies on Node's own type stripping.",
  "engines": {
    "node": ">=22.18 <23 || >=24.4"
  },
  "scripts": {
    "build": "turbo run build",
    "db:check": "node scripts/db.mjs check",
    "db:generate": "node scripts/db.mjs generate",
    "db:locate": "pnpm --filter @acorn/node-core db:locate",
    "db:migrate": "pnpm --filter @acorn/node-core db:migrate",
    "db:reset": "node scripts/db-reset.mjs",
    "dev": "turbo run dev",
    "dev:node": "pnpm --filter @acorn/node dev:node",
    "dev:plugin": "pnpm --filter @acorn/node dev:plugin",
    "dist": "pnpm --filter @acorn/desktop dist",
    "lint": "oxlint && turbo run lint",
    "lint:types": "turbo run lint",
    "pack:node": "node scripts/pack-node.mjs",
    "rebuild:node": "node scripts/rebuild-node-abi.mjs",
    "release": "pnpm dist",
    "test": "node scripts/rebuild-node-abi.mjs && turbo run test --continue --concurrency=6"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "node-pty": "^1.0.0",
    "oxlint": "^1.77.0",
    "turbo": "^2",
    "vite-plugin-solid": "^2.11.12"
  }
}
