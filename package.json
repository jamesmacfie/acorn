{
  "name": "acorn",
  "description": "The acorn monorepo: an agent workspace built as a desktop shell, a Node service, and a tree of plugins.",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.0.0",
  "//engines": "The security floor for Node's permission model, shared with node-runtime.json and @acorn/protocol/nodeRuntime.ts. scripts/pack-node.mjs copies this range into the standalone artifact.",
  "engines": {
    "node": ">=22.23.2 <23 || >=24.18.1 <25 || >=26.5.1 <27"
  },
  "scripts": {
    "build": "turbo run build",
    "backup:verify": "node scripts/verify-backup.mjs",
    "db:check": "node scripts/db.mjs check",
    "db:generate": "node scripts/db.mjs generate",
    "db:locate": "pnpm --filter @acorn/node-core db:locate",
    "db:migrate": "pnpm --filter @acorn/node-core db:migrate",
    "db:reset": "node scripts/db-reset.mjs",
    "dev": "turbo run dev",
    "dev:agent": "pnpm --filter @acorn/desktop dev:agent",
    "dev:agent:smoke": "pnpm --filter @acorn/desktop dev:agent:smoke",
    "dev:agent:ui": "pnpm --filter @acorn/desktop dev:agent:ui",
    "dev:extension": "pnpm --filter @acorn/extension dev",
    "dev:extension:ui": "pnpm --filter @acorn/extension dev:ui",
    "dev:tui:agent": "node scripts/agent-tui.mjs",
    "dev:tui:agent:ui": "pnpm --filter @acorn/tui agent:ui",
    "dev:tui:agent:flow": "node apps/tui/scripts/agent/flow-cli.mjs",
    "dev:no-watch": "pnpm --filter @acorn/desktop dev:no-watch",
    "dev:remote": "node scripts/remote-node.mjs",
    "dev:node": "pnpm --filter @acorn/node dev:node",
    "dev:plugin": "pnpm --filter @acorn/node dev:plugin",
    "dev:site": "pnpm --filter @acorn/site dev",
    "dist": "pnpm --filter @acorn/desktop dist",
    "format": "oxfmt",
    "lint": "oxlint && oxfmt --check && knip --no-config-hints && turbo run lint --continue",
    "lint:exports": "knip --no-config-hints",
    "lint:types": "turbo run lint",
    "pack:node": "node scripts/pack-node.mjs",
    "rebuild:node": "node scripts/rebuild-node-abi.mjs",
    "release": "pnpm dist",
    "test": "node scripts/rebuild-node-abi.mjs && VITEST_MAX_WORKERS=${VITEST_MAX_WORKERS:-3} turbo run test --continue --concurrency=${ACORN_TEST_CONCURRENCY:-6}",
    "test:focus": "node scripts/test-focus.mjs",
    "test:coverage": "node scripts/test-coverage.mjs"
  },
  "//overrides": "Runtime security floors, copied into the standalone npm manifest by scripts/pack-node.mjs. tools/arch/dependencySecurity.test.ts verifies pnpm uses the same policy.",
  "overrides": {
    "@hono/node-server": ">=2.0.11",
    "dompurify": ">=3.4.12",
    "fast-uri": "4.1.5",
    "hono": "4.13.11",
    "ip-address": "10.7.1",
    "katex": "^0.18.2",
    "proxy-addr": "^2.0.8",
    "qs": "6.16.0",
    "seroval": "^1.6.3"
  },
  "//acornStandalone": "The packed npm manifest uses the tested Node-compatible keymap release. Its unused optional Solid adapter peer follows our direct Solid range; no global peer bypass or downgrade.",
  "acornStandalone": {
    "dependencyPins": {
      "@opentui/keymap": "0.5.9"
    },
    "peerOverrides": {
      "@opentui/keymap": {
        "solid-js": "$solid-js"
      }
    }
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "knip": "^6.39.0",
    "node-pty": "^1.0.0",
    "oxfmt": "0.71.0",
    "oxlint": "^1.77.0",
    "turbo": "^2",
    "vite-plugin-solid": "^2.11.12"
  }
}
