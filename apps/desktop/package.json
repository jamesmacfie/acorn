    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/headless": "5.5.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^12.11.1",
    "diff": "^9.0.0",
    "drizzle-orm": "catalog:",
    "gitdiff-parser": "^0.3.1",
    "hono": "catalog:",
    "idb-keyval": "^6.2.5",
    "jose": "^6.2.3",
    "lucide-static": "^1.27.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.0.0",
