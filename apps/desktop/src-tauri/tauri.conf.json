{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "acorn",
  "version": "../package.json",
  "identifier": "com.acorn.desktop",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:4319",
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "vite build"
  },
  "plugins": {
    "//updater": "There is no updater plugin compiled in and no endpoint configured. The public key is here so every release is signed for it from the first one, which makes turning updates on later a configuration change rather than a re-release (docs/shell/packaging.md § Build and packaging). `createUpdaterArtifacts` stays off because Tauri would then need the private half during the build. The build makes unsigned payloads, and the release job signs them with the key from its protected environment.",
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERERkVDRjVGNDNDMzM1MzQKUldRME5jTkRYOC8rM1FOUEtqMVhWOEgvRDhBVjZuMllWQnZ1MTdsYmZyMk8rVTNmTUcyUmJpc0IK"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../dist/client": "client",
      "../dist/bridge": "bridge",
      "../dist/helper": "helper",
      "../dist/cli": "cli",
      "../dist/bundled-plugins": "plugins"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  }
}
