<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The bundle is signed with the hardened runtime, and the bundled Node runs under that signature.
  Without allow-jit, V8 can't reserve memory for compiled code and Node aborts before running a line,
  so the shell reports that the desktop helper exited during boot. The other two keys follow Node's own
  macOS release entitlements: V8 writes code pages, and node-pty's ad-hoc signed add-on has no team ID.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
