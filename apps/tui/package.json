{
  "name": "@acorn/tui",
  "version": "0.1.0",
  "description": "The terminal client. Phase 0: client-core booted under Node, drawing the kit with OpenTUI.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "capture": "vite build && node --experimental-ffi dist/capture.js",
    "dev": "vite build && node --experimental-ffi dist/main.js",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@acorn/client-core": "workspace:*",
    "@acorn/custody": "workspace:*",
    "@acorn/plugin-api": "workspace:*",
    "@acorn/plugin-notes": "workspace:*",
    "@acorn/protocol": "workspace:*",
    "@opentui/core": "^0.5.9",
    "@opentui/keymap": "^0.5.9",
    "@opentui/solid": "^0.5.9",
    "@tanstack/solid-query": "^5.101.0",
    "entities": "^7.0.1",
    "idb-keyval": "^6.2.5",
    "solid-js": "catalog:",
    "ws": "^8.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/ws": "^8.5.13",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.9"
  }
}
