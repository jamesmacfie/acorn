{
  "name": "@acorn/tui",
  "version": "0.1.0",
  "description": "The terminal client: client-core booted under Node, drawing the whole kit in cells.",
  "private": true,
  "type": "module",
  "//engines": "The repo's own floor, from node-runtime.json. This package used to need a newer Node than the rest of the repo, because the painter reached a native library through node:ffi; it draws its own cells in TypeScript now, so there is no reason left for it to differ (docs/future/terminal-rewrite/phase-4-cut-over.md).",
  "engines": {
    "node": ">=22.18 <23 || >=24.4"
  },
  "scripts": {
    "build": "vite build && node scripts/check-startup-graph.mjs",
    "capture": "vite build && node dist/capture.js",
    "dev": "vite build && node dist/main.js",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "//dependencies": "@opentui/keymap is the keyboard engine and nothing else: it is pure TypeScript, it holds no renderer, and @acorn/client-core drives the same one through the desktop's HTML adapter. The painter packages it used to arrive with, @opentui/core and @opentui/solid, are gone.",
  "dependencies": {
    "@acorn/client-core": "workspace:*",
    "@acorn/custody": "workspace:*",
    "@acorn/node-core": "workspace:*",
    "@acorn/plugin-agents": "workspace:*",
    "@acorn/plugin-api": "workspace:*",
    "@acorn/plugin-changes": "workspace:*",
    "@acorn/plugin-context": "workspace:*",
    "@acorn/plugin-docker": "workspace:*",
    "@acorn/plugin-editor": "workspace:*",
    "@acorn/plugin-github": "workspace:*",
    "@acorn/plugin-memory": "workspace:*",
    "@acorn/plugin-notes": "workspace:*",
    "@acorn/plugin-onboarding": "workspace:*",
    "@acorn/plugin-preview": "workspace:*",
    "@acorn/plugin-terminal": "workspace:*",
    "@acorn/plugin-workflows": "workspace:*",
    "@acorn/protocol": "workspace:*",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@opentui/keymap": "^0.5.9",
    "@tanstack/query-persist-client-core": "^5.101.0",
    "@tanstack/solid-query": "^5.101.0",
    "@xterm/headless": "5.5.0",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "entities": "^7.0.1",
    "gitdiff-parser": "^0.3.1",
    "idb-keyval": "^6.2.5",
    "seroval": "^1.3.3",
    "seroval-plugins": "^1.3.3",
    "solid-js": "catalog:",
    "ws": "^8.21.0",
    "yoga-layout": "3.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/ws": "^8.5.13",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.9"
  }
}
