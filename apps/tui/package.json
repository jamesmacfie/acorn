{
  "name": "@acorn/tui",
  "version": "1.0.0",
  "description": "The terminal client: client-core booted under Node, drawing the whole kit in cells.",
  "private": true,
  "type": "module",
  "//engines": "The repo's own floor, from node-runtime.json. This package used to need a newer Node than the rest of the repo, because the painter reached a native library through node:ffi; it draws its own cells in TypeScript now, so there is no reason left for it to differ (docs/tui.md \u00a7 The runtime floor).",
  "engines": {
    "node": ">=22.23.2 <23 || >=24.18.1 <25 || >=26.5.1 <27"
  },
  "scripts": {
    "build": "vite build && node scripts/check-startup-graph.mjs && node scripts/check-runtime-imports.mjs",
    "capture": "vite build && node dist/capture.js",
    "dev": "pnpm run build && node dist/main.js",
    "agent:session": "node scripts/agent/session.mjs",
    "agent:ui": "node scripts/agent/ui.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "//dependencies": "@opentui/keymap supplies the shared host-independent keyboard engine. The desktop uses its HTML adapter; the TUI supplies its own host and painter. Keymap still declares @opentui/core, which installs transitively even though these hosts' entrypoints do not value-import that renderer.",
  "dependencies": {
    "@acorn/client-core": "workspace:*",
    "@acorn/custody": "workspace:*",
    "@acorn/diff-document": "workspace:*",
    "@acorn/node-core": "workspace:*",
    "@acorn/plugin-agents": "workspace:*",
    "@acorn/plugin-api": "workspace:*",
    "@acorn/plugin-changes": "workspace:*",
    "@acorn/plugin-context": "workspace:*",
    "@acorn/plugin-docker": "workspace:*",
    "@acorn/plugin-editor": "workspace:*",
    "@acorn/plugin-github": "workspace:*",
    "@acorn/plugin-memory": "workspace:*",
    "@acorn/plugin-notes": "workspace:*",
    "@acorn/plugin-onboarding": "workspace:*",
    "@acorn/plugin-preview": "workspace:*",
    "@acorn/plugin-terminal": "workspace:*",
    "@acorn/plugin-workflows": "workspace:*",
    "@acorn/protocol": "workspace:*",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@opentui/keymap": "^0.5.9",
    "@tanstack/query-persist-client-core": "^5.101.0",
    "@tanstack/solid-query": "^5.101.0",
    "@xterm/headless": "5.5.0",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "drizzle-orm": "catalog:",
    "entities": "^7.0.1",
    "gitdiff-parser": "^0.3.1",
    "hono": "catalog:",
    "idb-keyval": "^6.2.5",
    "pg": "^8.22.0",
    "smol-toml": "^1.7.1",
    "solid-js": "catalog:",
    "ws": "^8.21.0",
    "yoga-layout": "3.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/ws": "^8.5.13",
    "node-pty": "^1.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.11"
  }
}
