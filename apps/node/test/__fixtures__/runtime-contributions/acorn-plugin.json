{
  "id": "runtime-fixture",
  "name": "Runtime contribution fixture",
  "version": "1.0.0",
  "apiVersion": "12",
  "node": "./node.js",
  "permissions": { "node": {} },
  "contributions": {
    "agentTools": [
      {
        "id": "echo",
        "description": "Echo validated arguments and verified task origin.",
        "inputSchema": {
          "type": "object",
          "properties": { "message": { "type": "string", "maxLength": 40 } },
          "required": ["message"],
          "additionalProperties": false
        },
        "risk": "read",
        "scope": "task",
        "handler": "/v2/p/runtime-fixture/tools/echo",
        "timeoutMs": 1000,
        "maxOutputBytes": 4096
      },
      {
        "id": "mutate",
        "description": "Mutate once for retry-semantics testing.",
        "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
        "risk": "write",
        "scope": "task",
        "handler": "/v2/p/runtime-fixture/tools/mutate",
        "requiresSession": true,
        "timeoutMs": 1000,
        "maxOutputBytes": 4096
      },
      {
        "id": "lost",
        "description": "Lose a reply after one mutation.",
        "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
        "risk": "write",
        "scope": "task",
        "handler": "/v2/p/runtime-fixture/tools/lost",
        "requiresSession": true,
        "timeoutMs": 1000,
        "maxOutputBytes": 4096
      },
      {
        "id": "slow",
        "description": "Wait beyond the declared deadline.",
        "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
        "risk": "read",
        "scope": "task",
        "handler": "/v2/p/runtime-fixture/tools/slow",
        "timeoutMs": 100,
        "maxOutputBytes": 4096
      },
      {
        "id": "large",
        "description": "Return more than the declared output ceiling.",
        "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
        "risk": "read",
        "scope": "task",
        "handler": "/v2/p/runtime-fixture/tools/large",
        "timeoutMs": 1000,
        "maxOutputBytes": 1024
      }
    ],
    "contextSections": [
      {
        "id": "fixture",
        "label": "Runtime fixture",
        "scope": "task",
        "order": 25,
        "read": "/v2/p/runtime-fixture/context",
        "defaultIncluded": false,
        "timeoutMs": 1000,
        "maxBytes": 4096,
        "maxTokens": 512
      }
    ]
  }
}
