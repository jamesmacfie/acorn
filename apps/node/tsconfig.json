{
  // The service composition root. No DOM: nothing here may reach for `window` or `document`, and
  // narrowing lib/types makes that a compile error rather than a runtime surprise inside a
  // supervised child process.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["node"]
  },
  "include": ["src", "test", "vite.config.ts"]
}
