---
import Feature from '../../components/Feature.astro'
import Snapshot from '../../components/Snapshot.astro'
import { FEATURES } from '../../features'
import FeaturePage from '../../layouts/FeaturePage.astro'
import type { PageMeta } from '../../meta'

export const meta = {
  description: FEATURES['task-tools'].sentence,
  sources: [
    'docs/panes.md',
    'docs/editor.md',
    'docs/editor/find-in-files.md',
    'docs/editor/file-navigation.md',
    'docs/database.md',
    'docs/http-client.md',
    'docs/docker.md',
    'docs/shell/webviews.md',
    'docs/notes-and-memory.md',
    'docs/agent-tools/context-sections.md',
    'docs/integrations/linear.md',
    'docs/integrations/rollbar.md',
    'docs/extensibility/runtime.md',
    'docs/first-party-plugins/terminal.md',
  ],
  checked: '7dd4aed34',
} satisfies PageMeta
---

<FeaturePage feature="task-tools" meta={meta} related={['tasks', 'plugins', 'automation']} docs={{ href: '/docs/built-in-plugins/', label: 'Read about the built-in plugins' }}>
  <Snapshot slot="picture" id="database" />

  <Feature title="Editor" href="/docs/built-in-plugins/editor/" link="Editor">
    <p>
      Edit the task's worktree in a CodeMirror editor, with the same colors a file has in a diff. Press{' '}
      <code>⌘P</code> to open a file by name, and <code>⌘⇧F</code> to search every file with ripgrep.
    </p>
  </Feature>

  <Feature title="Database" href="/docs/built-in-plugins/database/" link="Database">
    <p>
      A PostgreSQL client for the task: a SQL editor over a table list and a result grid. It finds the connection
      from the project's connection script, a <code>DATABASE_URL</code> in the worktree's <code>.env</code>, or the
      Node's environment, and the address never reaches the app. A task with none of those gets no Database pane.
    </p>
  </Feature>

  <Feature title="HTTP" href="/docs/built-in-plugins/http/" link="HTTP">
    <p>
      Build and send API requests from the task, saved to the project or kept to the task. Variables can be plain,
      secret, or the output of a command, and secret values are encrypted on the Node. A workflow step can send a
      request too.
    </p>
  </Feature>

  <Feature title="Docker" href="/docs/built-in-plugins/docker/" link="Docker">
    <p>
      The Docker pane shows the containers that belong to the task's worktree, with their logs, stats, details, and
      a shell inside each one. Start, stop, restart, and remove them there. When you archive the task, acorn offers
      to tear its containers down.
    </p>
  </Feature>

  <Feature title="Preview" href="/docs/built-in-plugins/preview/" link="Preview">
    <p>
      A browser pane that opens the task's running app, from a run target's address or the project's preview
      setting. Each task keeps its own page. It works only with the Node on your own computer, because a page served
      from a remote Node could reach services on your private network.
    </p>
  </Feature>

  <Feature title="Notes" href="/docs/using/notes/" link="Notes">
    <p>
      Markdown notes for a task, a workspace, or everything, kept as plain files on the Node that you can open by
      hand. Choose which notes go into an agent's context. Agents can read a task's notes and add to them.
    </p>
  </Feature>

  <Feature title="Context" href="/docs/using/task-context/" link="Task context">
    <p>
      The Context pane shows what an agent reads about its task: the pull request, linked issues, notes, and
      sections other plugins add. Pick the sections it gets.
    </p>
  </Feature>

  <Feature title="Linear" href="/docs/built-in-plugins/linear/" link="Linear">
    <p>
      Connect Linear to list issues in the rail, start a task from one on the issue's suggested branch, and read the
      linked issue in the task's pane. An agent in the task can read the issue, comment on it, and view its
      screenshots.
    </p>
  </Feature>

  <Feature title="Rollbar" href="/docs/built-in-plugins/rollbar/" link="Rollbar">
    <p>
      Connect Rollbar to list active errors in the rail, read an item with its newest occurrence and stack, and start
      a task from it. Payloads pass a privacy allowlist before acorn stores or shows them.
    </p>
  </Feature>

  <Fragment slot="terminal">
    <p>
      Database, HTTP, Docker, Notes, Context, Linear, and Rollbar draw the same panes in the terminal client. The
      editor keeps its file tree, search, and tabs, and can run your own <code>$EDITOR</code> where the built-in
      editor would be. The Preview pane isn't there. <a href="/docs/built-in-plugins/">Built-in plugins</a>
    </p>
  </Fragment>
</FeaturePage>
