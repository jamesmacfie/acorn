---
import DownloadPage from '../layouts/DownloadPage.astro'
import { readGithub } from '../lib/github'
import type { PageMeta } from '../meta'

export const meta = {
  description: 'Every way to get acorn: the desktop app, the terminal client, the standalone Node, the browser extension, and the source.',
  sources: [
    'README.md',
    'docs/node-distribution.md',
    'docs/cli.md',
    'docs/browser-extension/setup.md',
    'docs/shell/packaging.md',
    'apps/desktop/src-tauri/tauri.conf.json',
    'scripts/pack-node.mjs',
  ],
  checked: '3f99b39fc',
} satisfies PageMeta

const { release } = await readGithub()
---

<DownloadPage meta={meta} release={release} />
