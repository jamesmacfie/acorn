---
// The landing page, told in four chapters: the loop a task goes through, the window it happens in, the
// plugins that window is made of, and what acorn keeps safe. Every claim links to the docs page that
// owns it, and every picture is a specimen or a shell snapshot.
import { Code } from '@astrojs/starlight/components'
import Card from '../components/Card.astro'
import Hero from '../components/Hero.astro'
import InstallBlock from '../components/InstallBlock.astro'
import Snapshot from '../components/Snapshot.astro'
import SoftwareApplication from '../components/SoftwareApplication.astro'
import Specimen from '../components/Specimen.astro'
import Tour from '../components/Tour.astro'
import { PLUGINS } from '../data/plugins.ts'
import Marketing from '../layouts/Marketing.astro'
import { installMethods } from '../install'
import { ACORN_ART } from '../lib/acornArt'
import { readGithub } from '../lib/github'
import { lucideIcon } from '../lib/icons'
import type { PageMeta } from '../meta'
import { GITHUB } from '../nav'
import type { SnapshotId } from '../snapshots'

export const meta = {
  description:
    'A workspace for working with coding agents, one task at a time. Each task gets a branch, a Git worktree, terminals, and Claude Code and Codex sessions, in the desktop app or the terminal.',
  sources: [
    'docs/features.md',
    'docs/workspaces-and-tasks.md',
    'docs/workspaces-and-tasks/task-creation.md',
    'docs/workspaces-and-tasks/archive.md',
    'docs/managed-agents.md',
    'docs/tui.md',
    'docs/command-palette-and-shortcuts.md',
    'docs/panes.md',
    'docs/extensibility.md',
    'docs/first-party-plugins.md',
    'docs/plugins/agent-install.md',
    'docs/workflows.md',
    'docs/browser-extension.md',
    'docs/security/credentials.md',
    'docs/security/audit.md',
    'docs/security/plugin-bundles.md',
    'docs/telemetry.md',
    'docs/node-distribution.md',
    'docs/local-development.md',
    'docs/agent-tools/plugin-tools.md',
    'packages/create-acorn-plugin/index.mjs',
    'apps/site/src/data/plugins.ts',
  ],
  checked: '83c8184c2',
} satisfies PageMeta

const steps = [
  {
    title: 'Open a task',
    text: 'A task is one piece of work on one project. Give it a title, and acorn names a branch after it and creates its Git worktree the first time something needs the files.',
    specimen: 'task-rows',
    href: '/docs/using/tasks-and-worktrees/',
    link: 'Tasks and worktrees',
  },
  {
    title: 'Run agents in it',
    text: 'Start Claude Code and Codex sessions in the task and answer their permission requests as they come. Queue the next turn while one runs, or delegate work to a session of its own.',
    specimen: 'agent-turn',
    href: '/docs/agents/agent-sessions/',
    link: 'Agent sessions',
  },
  {
    title: 'Review and ship',
    text: 'Read the diff, open the pull request, and merge it without leaving the task. Archive the task and acorn stops its agents and terminals and removes its worktree, mess and all.',
    specimen: 'ship',
    href: '/docs/using/archive-and-restore/',
    link: 'Archive and restore',
  },
]

// One tab per feature group, in features.ts's order, leaving out the groups the chapters below cover:
// the two clients, plugins, and Nodes.
const tour: { id: string; label: string; snapshot: SnapshotId; text: string; href: string; link: string }[] = [
  {
    id: 'tasks',
    label: 'Tasks',
    snapshot: 'palette',
    text: 'A task holds a branch, a worktree, terminals, agent sessions, and a linked pull request or issue. Start one from GitHub, Linear, Rollbar, or the New task dialog, and press ⌘K for the command palette over it.',
    href: '/features/tasks/',
    link: 'More about tasks',
  },
  {
    id: 'agents',
    label: 'Agents',
    snapshot: 'context',
    text: "Claude Code and Codex run as managed sessions in the task's worktree, each with its transcript, usage, and requests. The Context pane is where you choose what the task tells them, and see how big it is.",
    href: '/features/agents/',
    link: 'More about agents',
  },
  {
    id: 'review',
    label: 'Review',
    snapshot: 'review',
    text: "The pull request pane has the checks, comments, review threads, and a diff in unified or split view with inline threads. Merge from the same pane, and the task's Changes tab commits and pushes.",
    href: '/features/review/',
    link: 'More about review',
  },
  {
    id: 'task-tools',
    label: 'Task tools',
    snapshot: 'database',
    text: "Each task has panes for the tools you'd otherwise open beside it: an editor with ripgrep search, a PostgreSQL client, an HTTP client, Docker containers, and a browser preview. Connect Linear and Rollbar to bring their issues in too.",
    href: '/features/task-tools/',
    link: 'More about task tools',
  },
  {
    id: 'browser',
    label: 'Browser',
    snapshot: 'browser',
    text: "The Chrome and Firefox extension shows the task behind the page you're on, and sends pages, selections, and screenshots to an agent.",
    href: '/features/browser/',
    link: 'More about the browser extension',
  },
  {
    id: 'automation',
    label: 'Workflows',
    snapshot: 'workflow',
    text: 'Workflows run agent, terminal, and check steps as a graph, with gates where a person decides. Run one on a schedule or from a script.',
    href: '/features/automation/',
    link: 'More about automation',
  },
]

const plugins = Object.values(PLUGINS).sort((a, b) => a.name.localeCompare(b.name))

// The command that scaffolds a plugin named Hello, and the pane entry it writes
// (packages/create-acorn-plugin/index.mjs). The specimen beside them is the pane it draws.
const scaffold = [{ label: 'Terminal', commands: ['npm create acorn-plugin hello-pane'] }]
const paneEntry = `"frames": [{
  "target": "pane",
  "id": "hello",
  "label": "Hello",
  "glyph": "puzzle",
  "order": 800,
  "layout": "single",
  "regions": {
    "body": { "kind": "remote", "entry": "pane" }
  }
}]`

// What a plugin can add, by where it shows up. Each is a guide's own title.
const canAdd = [
  {
    label: 'In the window',
    guides: [
      ['/docs/build-plugins/ui/add-a-pane/', 'Add a pane'],
      ['/docs/build-plugins/ui/add-a-source-to-the-left-rail/', 'Add a source to the left rail'],
      ['/docs/build-plugins/ui/add-commands-and-keybindings/', 'Add commands and keybindings'],
      ['/docs/build-plugins/ui/add-a-settings-page/', 'Add a settings page'],
      ['/docs/build-plugins/ui/put-a-badge-in-the-top-bar-or-task-footer/', 'Put a badge in the top bar or task footer'],
      ['/docs/build-plugins/ui/add-to-another-plugins-view/', "Add to another plugin's view"],
      ['/docs/build-plugins/ui/replace-the-top-bar-rail-or-pane-switcher/', 'Replace the top bar, rail, or pane switcher'],
      ['/docs/build-plugins/ui/add-a-theme-or-a-style-pack/', 'Add a theme or a style pack'],
      ['/docs/build-plugins/ui/draw-your-own-pixels-in-a-frame/', 'Draw your own pixels in a frame'],
    ],
  },
  {
    label: 'On the Node',
    guides: [
      ['/docs/build-plugins/node/give-agents-tools/', 'Give agents tools'],
      ['/docs/build-plugins/node/add-task-context/', 'Add task context'],
      ['/docs/build-plugins/node/act-on-agent-turns-with-hooks/', 'Act on agent turns with hooks'],
      ['/docs/build-plugins/node/add-a-harness/', 'Add a harness'],
      ['/docs/build-plugins/node/ship-custom-agents-and-skills/', 'Ship custom agents and skills'],
      ['/docs/build-plugins/node/add-a-workflow-step/', 'Add a workflow step'],
      ['/docs/build-plugins/node/run-work-on-a-schedule/', 'Run work on a schedule'],
      ['/docs/build-plugins/node/connect-a-service/', 'Connect a service'],
      ['/docs/build-plugins/node/add-a-command-line-command/', 'Add a command-line command'],
    ],
  },
]

const trust = [
  ['/docs/security/the-trust-model/', 'Agents get a scoped token', 'An agent gets a token that reaches only its own task. acorn never puts your GitHub token or API keys in its environment.'],
  ['/docs/security/credentials-and-secrets/', 'Credentials are encrypted', 'Stored credentials are encrypted at rest and never returned by the Node. Backups leave them out.'],
  ['/docs/security/plugin-trust-and-permissions/', 'Plugins are sandboxed', 'An installed plugin draws from a sandbox and gets only the permissions you accept, on each device.'],
  ['/docs/security/telemetry-and-privacy/', 'Telemetry is off', 'Telemetry is off by default. Nothing leaves the machine unless you turn it on and add a destination.'],
  ['/docs/nodes/run-a-standalone-node/', 'Run it on a server', 'The desktop app runs a Node on your computer. Pair a standalone Node on a server and use it from either client or the command line.'],
  [GITHUB, 'Open source', 'The code is on GitHub under the MIT license.'],
]

const faq = [
  {
    question: 'What does it cost?',
    answer: 'Nothing. acorn is open source under the MIT license.',
    href: `${GITHUB}/blob/main/LICENSE`,
    link: 'Read the license',
  },
  {
    question: 'Do I need an API key?',
    answer: 'Not for agents. acorn runs Claude Code and Codex, and each signs in with its own login. An API key is optional, for features such as SQL generation.',
    href: '/docs/agents/model-providers-and-generating-text/',
    link: 'Model providers and generating text',
  },
  {
    question: 'Does my code leave my machine?',
    answer: 'Your code stays on the machine that runs the Node. acorn talks to the services you connect, such as GitHub, and your agents talk to their own providers. Telemetry is off by default.',
    href: '/docs/security/telemetry-and-privacy/',
    link: 'Telemetry and privacy',
  },
  {
    question: 'Which platforms?',
    answer: 'The desktop app runs on macOS and Windows. The terminal client and the standalone Node run wherever Node.js runs, Linux included.',
    href: '/docs/start/install/',
    link: 'Install',
  },
  {
    question: 'How is it different from a terminal multiplexer or an IDE?',
    answer: 'A task owns its branch, worktree, terminals, agent sessions, and pull request, and they all sit in one window. Archiving the task stops what runs in it and removes its worktree.',
    href: '/docs/start/concepts/',
    link: 'Concepts',
  },
  {
    question: 'Can a plugin break the app or read my keys?',
    answer: "An installed plugin runs in a sandbox, draws only with acorn's components, and gets only the permissions its manifest declares and you accept on each device.",
    href: '/docs/security/plugin-trust-and-permissions/',
    link: 'Plugin trust and permissions',
  },
  {
    question: 'Can I run it on another machine?',
    answer: 'Yes. Run a standalone Node there, pair it, and use it from the desktop app, the terminal client, or the command line.',
    href: '/docs/nodes/pair-a-device-or-a-remote-node/',
    link: 'Pair a device or a remote Node',
  },
]

// Until there's a release to download, the download page offers ways to build acorn.
const { release } = await readGithub()
const getAcorn = release ? 'Download' : 'Get acorn'
---

<Marketing title="A workspace for working with coding agents" meta={meta}>
  <SoftwareApplication slot="head" release={release} />
  <Hero slot="hero" title="Let your agents go nuts." split>
    <p>
      acorn is a workspace for Claude Code and Codex. Each task gets its own branch, worktree, terminals, and agent
      sessions, so your agents make their mess somewhere safe. Read the diff, merge the pull request, and archive the
      rest.
    </p>
    <p class="hero-meta">
      <a href="/docs/start/install/">macOS · Windows</a> ·{' '}
      <a href="/docs/start/desktop-and-terminal/">terminal client</a> · <a href={`${GITHUB}/blob/main/LICENSE`}>MIT</a>
    </p>
    <Fragment slot="actions">
      <a class="button" data-variant="primary" href="/download/">{getAcorn}</a>
      <a class="button" href="/docs/">Read the docs</a>
    </Fragment>
    <div slot="picture" class="hero-shot">
      <div class="tabs" role="tablist" aria-label="Client" data-tabs hidden>
        <button type="button" role="tab" aria-controls="hero-shot-desktop">Desktop</button>
        <button type="button" role="tab" aria-controls="hero-shot-terminal">Terminal</button>
      </div>
      <div id="hero-shot-desktop" role="tabpanel" aria-label="Desktop"><Snapshot id="hero" /></div>
      <div id="hero-shot-terminal" role="tabpanel" aria-label="Terminal"><Snapshot id="hero-terminal" /></div>
    </div>
  </Hero>

  <section class="section chapter" aria-labelledby="loop">
    <header class="chapter-head">
      <h2 id="loop">Every mess gets its own branch.</h2>
      <p class="lede">
        The usual task gets a branch and a worktree of its own, so agents on different tasks work in different checkouts
        and don't trip over each other.
      </p>
    </header>
    <ol class="loop">
      {
        steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <a href={step.href}>{step.link}</a>
            <Specimen id={step.specimen} />
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section chapter" aria-labelledby="window">
    <header class="chapter-head">
      <h2 id="window">You can close a few windows now.</h2>
      <p class="lede">The pull request, the terminals, and the other tools a task needs open as panes inside it.</p>
    </header>
    <Tour tabs={tour}>
      {tour.map((tab) => <Snapshot slot={tab.id} id={tab.snapshot} />)}
    </Tour>
  </section>

  <section class="section chapter band" aria-labelledby="plugins">
    <header class="chapter-head">
      <h2 id="plugins">Take it apart.</h2>
      <p class="lede">
        Every pane in that window comes from a plugin, and so do the terminal drawer and most of the icons on its rails.
        A plugin you install uses the same seams, and draws in both clients.{' '}
        <a href="/features/plugins/">More about plugins</a>
      </p>
    </header>

    <div class="xray">
      <Snapshot
        id="hero"
        instance="plugins"
        caption="The task from the top of the page, with what plugins draw outlined: the Git and Agent panes, the Terminal drawer, five sources on the left rail, and every pane's button on the right."
      />
    </div>

    <div class="wall-head">
      <h3>What ships with acorn</h3>
      <a href="/plugins/">See what each one adds</a>
    </div>
    <ul class="wall">
      {
        plugins.map((plugin) => (
          <li>
            <span class="wall-icon" aria-hidden="true" set:html={lucideIcon(plugin.icon)} />
            <a href={plugin.docs}>{plugin.name}</a>
          </li>
        ))
      }
      <li class="wall-yours">
        <span class="wall-icon" aria-hidden="true" set:html={lucideIcon('plus')} />
        <a href="/docs/build-plugins/start/build-your-first-plugin/">Yours</a>
      </li>
    </ul>

    <h3 class="build-head">Then add your own.</h3>
    <div class="build">
      <div class="build-path">
        <h4>Start from the scaffold</h4>
        <p>
          <code>npm create acorn-plugin</code> writes a plugin with one pane. This is the pane's entry in its manifest,
          beside the pane it draws in each client.{' '}
          <a href="/docs/build-plugins/start/build-your-first-plugin/">Build your first plugin</a>
        </p>
        <InstallBlock id="scaffold" methods={scaffold} />
        <Code code={paneEntry} lang="json" title="acorn-plugin.json" />
      </div>
      <Specimen id="starter-pane" />
      <div class="build-path">
        <h4>Or ask your agent</h4>
        <p>
          Ask an agent in any task for "a pane that lists this task's TODO comments". It reads your Node's plugin
          vocabulary with <code>plugin_authoring</code>, writes the package, and asks to install it. Nothing installs
          until you approve. In development mode, the Node reloads the plugin each time the agent saves.{' '}
          <a href="/docs/build-plugins/start/have-your-agent-build-it/">Have your agent build it</a>
        </p>
      </div>
      <Specimen id="plugin-turn" />
    </div>

    <div class="can">
      <h4>What a plugin can add</h4>
      {
        canAdd.map((group) => (
          <div class="can-group">
            <p class="eyebrow">{group.label}</p>
            <ul>
              {group.guides.map(([href, title]) => (
                <li>
                  <a href={href}>{title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section chapter" aria-labelledby="trust">
    <header class="chapter-head">
      <h2 id="trust">The agents don't get your keys.</h2>
      <p class="lede">
        Your code stays on the machine that runs the Node, and acorn limits what the agents and plugins there can reach.
      </p>
    </header>
    <ul class="cells">
      {
        trust.map(([href, title, text]) => (
          <li>
            <Card title={title} href={href}>
              <p>{text}</p>
            </Card>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section faq" aria-labelledby="questions">
    <div class="faq-head">
      <h2 id="questions">Questions</h2>
      <a href="/docs/help/faq/">More in the FAQ</a>
    </div>
    <div class="faq-list">
      {
        faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>
              {item.answer} <a href={item.href}>{item.link}</a>
            </p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section finale band" aria-labelledby="get-acorn">
    <div class="finale-text">
      <h2 id="get-acorn">Give them a task.</h2>
      <InstallBlock id="footer-install" methods={installMethods} />
      <div class="actions">
        <a class="button" data-variant="primary" href="/download/">{getAcorn}</a>
        <a class="button" href="/docs/">Read the docs</a>
      </div>
    </div>
    <pre class="finale-art" aria-hidden="true">{ACORN_ART}</pre>
  </section>
</Marketing>

<script>
  import '../scripts/tabs'
</script>

<style>
  /* ── Hero ── */
  .hero-meta {
    margin-block-start: var(--space-8);
    font-size: var(--fs-sm);
  }
  .hero-shot {
    display: grid;
    gap: var(--space-5);
  }
  .hero-shot > * {
    margin: 0;
    min-inline-size: 0;
  }

  /* ── Chapters ──
     Each of the four opens with a display heading and a lede. There's no label above the heading,
     because a caps label over every heading is a mark of a generated page. */
  .chapter-head {
    display: grid;
    gap: var(--space-8);
    justify-items: start;
  }
  .chapter-head > * {
    margin: 0;
  }
  .chapter h2,
  .finale h2 {
    max-inline-size: 20ch;
    font-size: var(--site-fs-display);
    /* Mono at display size reads loose, as the hero's headline does. */
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .lede {
    max-inline-size: 60ch;
    font-size: var(--fs-xl);
  }
  .chapter h3 {
    margin: 0;
    font-size: var(--fs-xl);
  }
  .chapter h4 {
    margin: 0;
    font-size: var(--fs-lg);
  }

  /* A chapter on its own band runs the subtle background to the window's edges. The shadow paints past
     the column without widening the page, and the clip keeps it off the chapters above and below. */
  .band {
    margin-block-start: var(--site-section);
    padding-block: var(--site-section);
    background: var(--bg-subtle);
    box-shadow: 0 0 0 100vmax var(--bg-subtle);
    clip-path: inset(0 -100vmax);
  }

  /* ── The loop ──
     The three steps side by side on a wide screen, each under a length of track. The accent fills the
     track left to right as the steps scroll through the window: one task moving from open to merged. */
  .loop {
    display: grid;
    gap: var(--site-section) var(--space-11);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .loop > li {
    position: relative;
    display: grid;
    gap: var(--space-6);
    align-content: start;
    justify-items: start;
    padding-block-start: var(--space-10);
    view-timeline-name: --step;
  }
  .loop > li > * {
    margin: 0;
    min-inline-size: 0;
  }
  .loop > li > :global(.specimen) {
    justify-self: stretch;
    margin-block-start: var(--space-6);
  }
  .loop > li::before,
  .loop > li::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    border-block-start: var(--bw-strong) solid var(--border-strong);
  }
  .loop > li::after {
    border-color: var(--accent);
    transform-origin: left;
  }
  /* Side by side, the steps share their rows, so the titles, the links, and the frames line up across
     them, and each frame fills its row. The steps carry no numbers, because the list and the
     track already give the order. */
  @media (min-width: 64rem) {
    .loop {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: var(--space-6);
    }
    .loop > li {
      grid-row: span 4;
      grid-template-rows: subgrid;
      row-gap: var(--space-6);
    }
    .loop > li > :global(.specimen) {
      display: flex;
      flex-direction: column;
      align-self: stretch;
    }
    .loop > li > :global(.specimen .views) {
      flex: 1;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* Each length of track fills while its step's top rises through the window, the next a little
         after the one before, so side by side they fill left to right. */
      .loop > li::after {
        animation: fill-track linear both;
        animation-timeline: --step;
        animation-timing-function: var(--ease-out);
      }
      .loop > li:nth-child(1)::after {
        animation-range: cover 5vh cover 35vh;
      }
      .loop > li:nth-child(2)::after {
        animation-range: cover 20vh cover 50vh;
      }
      .loop > li:nth-child(3)::after {
        animation-range: cover 35vh cover 65vh;
      }
    }
  }
  @keyframes fill-track {
    from {
      scale: 0 1;
    }
  }

  /* ── Plugins ──
     The hero's window again, with each part a plugin draws outlined in the accent. The selectors name
     each part by what the capture itself calls it, such as the Git pane's "Git list", so a new capture
     keeps them. The rail's Home and Archive aren't plugins, so they stay plain. */
  /* How far the outlines and names have come in, from 0 to 1. Registered, so it animates, and it starts
     at 1, so without the animation everything shows. */
  @property --xray {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }
  .xray
    :global(
      :is(
          .pane:has(> [aria-label='Git list']),
          .pane:has(> [aria-label='Agent list']),
          .ui-drawer,
          [data-source-id='git'],
          [data-source-id='docker'],
          [data-source-id='workflows'],
          [data-source-id='agents'],
          [data-source-id='memory'],
          .pane-switcher .tabrail-tab:not(.tabrail-bottom)
        )
    ) {
    outline: calc(var(--xray) * var(--bw-strong)) dashed var(--accent);
    outline-offset: calc(-1 * var(--bw-strong));
  }
  /* The three big parts carry their plugin's name. The window draws at 1440 pixels and scales down, so
     the name is set large enough to read once it has. */
  .xray :global(.pane) {
    position: relative;
  }
  .xray :global(:is(.pane:has(> [aria-label='Git list']), .pane:has(> [aria-label='Agent list']), .ui-drawer))::after {
    position: absolute;
    inset: auto var(--space-6) var(--space-6) auto;
    z-index: 1;
    padding: var(--space-3) var(--space-5);
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: var(--fw-bold);
    line-height: 1;
    color: var(--bg);
    background: var(--text);
    opacity: var(--xray);
  }
  .xray :global(.pane:has(> [aria-label='Git list']))::after {
    content: 'git';
  }
  .xray :global(.pane:has(> [aria-label='Agent list']))::after {
    content: 'agents';
  }
  .xray :global(.ui-drawer)::after {
    content: 'terminal';
  }
  /* On a phone the window is a quarter of its size, too small for the names, so the caption says it. */
