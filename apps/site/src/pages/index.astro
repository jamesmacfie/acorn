---
// The landing page, one idea a screen: what a task is, the panes it opens, the plugins they're made of,
// answering agents from the browser and the phone, and Nodes on other machines. Every claim links to the
// page that owns it. Every picture is a capture of acorn, or a drawing made from the site fixture's facts.
import Badge from '../components/Badge.astro'
import Hero from '../components/Hero.astro'
import InstallBlock from '../components/InstallBlock.astro'
import SidebarPicture from '../components/SidebarPicture.astro'
import Snapshot from '../components/Snapshot.astro'
import SnapshotFrame from '../components/SnapshotFrame.astro'
import SoftwareApplication from '../components/SoftwareApplication.astro'
import Specimen from '../components/Specimen.astro'
import Tour from '../components/Tour.astro'
import { PLUGINS } from '../data/plugins.ts'
import Marketing from '../layouts/Marketing.astro'
import { installMethods } from '../install'
import { ACORN_ART } from '../lib/acornArt'
import { readGithub } from '../lib/github'
import { lucideIcon } from '../lib/icons'
import type { PageMeta } from '../meta'
import { GITHUB } from '../nav'
import type { SnapshotId } from '../snapshots'

export const meta = {
  description:
    'Run Claude Code and Codex on several pieces of work at once, each on its own branch and worktree, and answer them from your desk, your browser, or your phone.',
  sources: [
    'docs/features.md',
    'docs/workspaces-and-tasks.md',
    'docs/workspaces-and-tasks/task-creation.md',
    'docs/workspaces-and-tasks/archive.md',
    'docs/managed-agents.md',
    'docs/tui.md',
    'docs/command-palette-and-shortcuts.md',
    'docs/panes.md',
    'docs/extensibility.md',
    'docs/first-party-plugins.md',
    'docs/plugins/agent-install.md',
    'docs/agent-tools/plugin-tools.md',
    'docs/workflows.md',
    'docs/browser-extension.md',
    'docs/browser-extension/task-pages.md',
    'docs/mobile.md',
    'docs/mobile/phone-setup.md',
    'docs/relay.md',
    'docs/authentication.md',
    'docs/node-distribution.md',
    'docs/architecture/fleet.md',
    'docs/cli/local-service.md',
    'docs/security.md',
    'docs/security/credentials.md',
    'docs/security/plugin-bundles.md',
    'docs/telemetry.md',
    'apps/cli/src/output.ts',
    'apps/site/src/data/plugins.ts',
  ],
  checked: '5793babb4',
} satisfies PageMeta

// The site fixture's three tasks on billing-api, each on its own branch, with the agent working in it and
// what that agent waits on. The phone's Needs you below lists the same three.
const lanes = [
  {
    branch: 'retry-failed-webhooks',
    title: 'Retry failed webhooks',
    agent: 'Claude Code',
    state: 'Finished its turn',
    tone: 'neutral',
  },
  { branch: 'add-eu-vat', title: 'Add VAT to EU invoices', agent: 'Codex', state: 'Wants permission', tone: 'warn' },
  {
    branch: 'speed-up-the-overdue-invoices-query',
    title: 'Speed up the overdue invoices query',
    agent: 'Claude Code',
    state: 'Asked a question',
    tone: 'warn',
  },
] as const

const steps = [
  {
    title: 'Open a task',
    text: 'Give it a title, and acorn names a branch after it and sets up a worktree.',
    href: '/docs/using/tasks-and-worktrees/',
    link: 'Tasks and worktrees',
  },
  {
    title: 'Run agents in it',
    text: 'Start Claude Code or Codex in it. Answer them there when they ask a question or want permission.',
    href: '/docs/agents/agent-sessions/',
    link: 'Agent sessions',
  },
  {
    title: 'Review and ship',
    text: 'Merge the pull request, then archive the task. That stops its agents and deletes the worktree, mess and all.',
    href: '/docs/using/archive-and-restore/',
    link: 'Archive and restore',
  },
]

// One tab per feature group, in features.ts's order, leaving out what the chapters below cover: plugins,
// the browser, and Nodes.
const tour: { id: string; label: string; snapshot: SnapshotId; text: string; href: string; link: string }[] = [
  {
    id: 'tasks',
    label: 'Tasks',
    snapshot: 'palette',
    text: 'Start a task from a pull request, a Linear issue, a Rollbar error, or from scratch. ⌘K opens the command palette.',
    href: '/features/tasks/',
    link: 'More about tasks',
  },
  {
    id: 'agents',
    label: 'Agents',
    snapshot: 'context',
    text: "Claude Code and Codex run in the task's worktree. Each new agent starts with the pull request, the linked issues, and your notes, and the Context pane is where you pick what goes in.",
    href: '/features/agents/',
    link: 'More about agents',
  },
  {
    id: 'review',
    label: 'Review',
    snapshot: 'review',
    text: 'The pull request pane shows the checks, the review comments, and the diff, unified or split. You merge from there too.',
    href: '/features/review/',
    link: 'More about review',
  },
  {
    id: 'task-tools',
    label: 'Task tools',
    snapshot: 'database',
    text: 'A code editor, a PostgreSQL client, an HTTP client, Docker, and a browser preview, each one a pane in the task.',
    href: '/features/task-tools/',
    link: 'More about task tools',
  },
  {
    id: 'automation',
    label: 'Workflows',
    snapshot: 'workflow',
    text: 'A workflow chains agent runs, terminal commands, and checks, and can stop to wait for your approval. Run one on a schedule or from a script.',
    href: '/features/automation/',
    link: 'More about automation',
  },
]

const plugins = Object.values(PLUGINS).sort((a, b) => a.name.localeCompare(b.name))

// The phone's two pictures, each captured in Catppuccin Latte and Mocha so it follows the page's light
// and dark switch as the HTML pictures do.
// shortcut: these are screenshots taken by hand from the site fixture on a throwaway Node, through a
// stand-in account service and relay (docs/site/snapshots.md § The phone pictures), and nothing checks
// them against the code. Add a phone scene to scripts/capture-shell.mjs when they need a refresh.
const phone = [
  {
    id: 'phone-waiting',
    label: 'Needs you',
    file: 'tasks',
    caption: "The workspace's tasks on a phone, under the three agents waiting on you.",
    alt: "Needs you lists three agents: one wants permission, one asked a question, and one finished its turn. The workspace's three tasks follow.",
  },
  {
    id: 'phone-agent',
    label: 'The agent',
    file: 'agent',
    caption: "The webhooks task's agent on a phone, with the task's panes along the bottom.",
    alt: "The agent's last answer in the Retry failed webhooks task, the message box under it, and a bar of the task's panes: Agent, Git, Notes, Context, Editor, and Terminal.",
  },
]

// What `acorn node reach` and `acorn node pair` print on a server (apps/cli/src/output.ts), with a
// documentation address, and the identity words and the code of a throwaway Node.
const pairing = `$ acorn node reach build-box.local
Connect to    https://build-box.local:4317
Set by        node.json
Addresses     192.0.2.10 (eth0)

The Node restarted to apply the change.

$ acorn node pair
Connect to    https://build-box.local:4317
Identity      helmet amber finch hedge forge bell
Pairing code  ruBm8AwlUnz0hOUn4sLDwg   (valid 10 minutes)

On the other machine, open Settings → Nodes, add a node, and check that the identity words match.`

const faq = [
  {
    question: 'What does it cost?',
    answer: 'Nothing. acorn is open source under the MIT license.',
    href: `${GITHUB}/blob/main/LICENSE`,
    link: 'Read the license',
  },
  {
    question: 'Do I need an API key?',
    answer:
      'Not for agents. Claude Code and Codex sign in the way they always do. A key is optional, for extras such as writing SQL from a description.',
    href: '/docs/agents/model-providers-and-generating-text/',
    link: 'Model providers and generating text',
  },
  {
    question: 'Does my code leave my machine?',
    answer:
      'Your code stays on the machine where your agents run. acorn talks to the services you connect, such as GitHub, and your agents talk to their own providers. Telemetry is off by default.',
    href: '/docs/security/telemetry-and-privacy/',
    link: 'Telemetry and privacy',
  },
  {
    question: 'Does the phone app need an account?',
    answer:
      "Yes. Your phone reaches your computer through a relay server, so you sign in and turn on remote access first. Nothing else needs an account, and acorn doesn't contact the account service until you sign in.",
    href: '/docs/built-in-plugins/account/',
    link: 'Account',
  },
  {
    question: 'Which platforms?',
    answer:
      "The desktop app runs on macOS and Windows. The terminal app and the server Node run anywhere Node.js does, Linux included. The phone app runs in your phone's browser.",
    href: '/docs/start/install/',
    link: 'Install',
  },
  {
    question: 'How is it different from a terminal multiplexer or an IDE?',
    answer:
      'A task keeps its branch, worktree, terminals, agents, and pull request together in one window. Archive the task, and everything running in it stops and its worktree is deleted.',
    href: '/docs/start/concepts/',
    link: 'Concepts',
  },
]

// Until there's a release to download, the download page offers ways to build acorn.
const { release } = await readGithub()
const getAcorn = release ? 'Download' : 'Get acorn'

// The closing acorn in two pieces, its stalk and cap over its nut, so the cap can tip on its own.
const art = ACORN_ART.split('\n')
const cap = art.slice(0, 4).join('\n')
const nut = art.slice(4).join('\n')
---

<Marketing title="A workspace for working with coding agents" meta={meta}>
  <SoftwareApplication slot="head" release={release} />
  <Hero slot="hero" title="Let your agents go nuts." highlight="go nuts." split>
    <p>
      Run Claude Code and Codex on several pieces of work at once, each on its own branch and worktree, so they don't
      trip over each other.
    </p>
    <Fragment slot="actions">
      <a class="button" data-variant="primary" data-size="lg" href="/download/">{getAcorn}</a>
      <a class="button" data-size="lg" href="/docs/">Read the docs</a>
    </Fragment>
    <div slot="picture" class="hero-shot">
      <div class="tabs segmented" role="tablist" aria-label="Client" data-tabs hidden>
        <button type="button" role="tab" aria-controls="hero-shot-desktop">Desktop</button>
        <button type="button" role="tab" aria-controls="hero-shot-terminal">Terminal</button>
      </div>
      <div id="hero-shot-desktop" role="tabpanel" aria-label="Desktop"><Snapshot id="hero" /></div>
      <div id="hero-shot-terminal" role="tabpanel" aria-label="Terminal"><Snapshot id="hero-terminal" /></div>
    </div>
  </Hero>

  <section class="section chapter" aria-labelledby="loop">
    <header class="chapter-head">
      <h2 id="loop">Every mess gets its own branch.</h2>
      <p class="lede">
        In acorn, each piece of work is a task, like a bug fix or a new feature. A task's agents work in their own
        copy of the repo, so several tasks can run at once without touching each other's files.
      </p>
    </header>
    <figure class="lanes">
      <p class="lanes-main"><code>main</code></p>
      <ol>
        {
          lanes.map((lane) => (
            <li class="lane">
              <code class="lane-branch">{lane.branch}</code>
              <span class="lane-title">{lane.title}</span>
              <span class="lane-agent">
                {lane.agent}
                <Badge tone={lane.tone}>{lane.state}</Badge>
              </span>
            </li>
          ))
        }
      </ol>
      <figcaption class="sr-only">
        Three tasks on the billing-api project, each on a branch off main, with the agent working in it and what
        that agent is waiting on.
      </figcaption>
    </figure>
    <ol class="loop">
      {
        steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <a href={step.href}>{step.link}</a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section chapter" aria-labelledby="window">
    <header class="chapter-head">
      <h2 id="window">You can close a few windows now.</h2>
      <p class="lede">A task's pull request, terminals, and other tools open as panes in the same window.</p>
    </header>
    <Tour tabs={tour}>
      {tour.map((tab) => <Snapshot slot={tab.id} id={tab.snapshot} />)}
    </Tour>
  </section>

  <section class="section chapter band" aria-labelledby="plugins">
    <header class="chapter-head">
      <h2 id="plugins">Take it apart.</h2>
      <p class="lede">
        Every pane in that window is a plugin, and so are the terminal and most of the icons down its sides. Plugins you
        write or install are built the same way, and work in both the desktop app and the terminal app.{' '}
        <a href="/features/plugins/">More about plugins</a>
      </p>
    </header>

    <div class="xray">
      <Snapshot
        id="hero"
        instance="plugins"
        caption="The task from the top of the page, with every part a plugin draws outlined: the Git and Agent panes, the terminal, five icons down the left side, and every pane's button on the right."
      />
    </div>

    <div class="wall-head">
      <h3>What ships with acorn</h3>
      <a href="/plugins/">See what each one adds</a>
    </div>
    <ul class="wall">
      {
        plugins.map((plugin) => (
          <li>
            <span class="wall-icon" aria-hidden="true" set:html={lucideIcon(plugin.icon)} />
            <a href={plugin.docs}>{plugin.name}</a>
          </li>
        ))
      }
      <li class="wall-yours">
        <span class="wall-icon" aria-hidden="true" set:html={lucideIcon('plus')} />
        <a href="/docs/build-plugins/start/build-your-first-plugin/">Yours</a>
      </li>
    </ul>

    <div class="build">
      <div class="build-text">
        <h3>Or ask an agent for one.</h3>
        <p>
          Tell an agent what you're missing, like a pane that lists the task's TODO comments. It reads acorn's plugin
          docs, writes the plugin, and installs nothing until you approve it.
        </p>
        <p>
          A plugin can add panes, sidebar lists, commands, agent tools, workflow steps, and themes. One you install runs
          in a sandbox, with only the permissions you grant it.
        </p>
        <ul class="actions">
          <li><a href="/docs/build-plugins/start/have-your-agent-build-it/">Have your agent build it</a></li>
          <li><a href="/docs/build-plugins/start/build-your-first-plugin/">Build your first plugin</a></li>
          <li><a href="/docs/security/plugin-trust-and-permissions/">Plugin trust and permissions</a></li>
        </ul>
      </div>
      <Specimen id="plugin-turn" />
    </div>
  </section>

  <section class="section chapter" aria-labelledby="away">
    <header class="chapter-head">
      <h2 id="away">Step away from the desk.</h2>
      <p class="lede">
        The browser extension and the phone app open the same tasks, so you can answer an agent from wherever you are.
      </p>
    </header>
    <div class="away">
      <div class="away-item">
        <div class="away-shot">
          <div class="tabs segmented" role="tablist" aria-label="Browser panel" data-tabs hidden>
            <button type="button" role="tab" aria-controls="browser-task">On the issue</button>
            <button type="button" role="tab" aria-controls="browser-chat">In a chat</button>
          </div>
          <div id="browser-task" role="tabpanel" aria-label="On the issue">
            <SidebarPicture id="sidebar-issue-task" />
          </div>
          <div id="browser-chat" role="tabpanel" aria-label="In a chat">
            <SidebarPicture id="sidebar-issue-conversation" />
          </div>
        </div>
        <h3>In the browser</h3>
        <p>
          Open a Linear issue, and the extension's side panel shows its task: the agents, what they're waiting on, and a
          box to message them. Your browser never holds the key to acorn.
        </p>
        <a href="/features/browser/">More about the browser extension</a>
      </div>
      <div class="away-item">
        <div class="away-shot">
          <div class="tabs segmented" role="tablist" aria-label="Phone screen" data-tabs hidden>
            {
              phone.map((screen) => (
                <button type="button" role="tab" aria-controls={screen.id}>
                  {screen.label}
                </button>
              ))
            }
          </div>
          {
            phone.map((screen) => (
              <div id={screen.id} role="tabpanel" aria-label={screen.label}>
                <SnapshotFrame host="phone" caption={screen.caption}>
                  <div class="phone-screen">
                    {(['light', 'dark'] as const).map((scheme) => (
                      <img
                        src={`/phone/${screen.file}-${scheme}.webp`}
                        data-scheme={scheme}
                        width="390"
                        height="844"
                        alt={screen.alt}
                        loading="lazy"
                        decoding="async"
                      />
                    ))}
                  </div>
                </SnapshotFrame>
              </div>
            ))
          }
        </div>
        <h3>On your phone</h3>
        <p>
          Turn on remote access, then pair your phone by matching three words with a device you've already paired. Its
          Needs you list shows every agent that's waiting on you.
        </p>
        <a href="/docs/built-in-plugins/account/#turn-on-remote-access">Turn on remote access</a>
      </div>
    </div>
  </section>

  <section class="section chapter" aria-labelledby="nodes">
    <header class="chapter-head">
      <h2 id="nodes">Put the agents on a bigger machine.</h2>
      <p class="lede">
        Your agents run inside a Node, a background service the desktop app starts on your computer. Run a Node on a
        server too, and its agents keep working while your laptop sleeps.
      </p>
    </header>
    <div class="nodes">
      <SnapshotFrame
        host="terminal"
        caption="A standalone Node on a server, made reachable by its name, then opening a pairing window for a laptop."
      >
        <pre class="pairing">{pairing}</pre>
      </SnapshotFrame>
      <div class="nodes-text">
        <dl>
          <div>
            <dt>Pair from any client</dt>
            <dd>
              Check that the six words match on both screens, then enter the code. From then on, your app trusts that
              Node and nothing pretending to be it.
            </dd>
          </div>
          <div>
            <dt>Every Node in one place</dt>
            <dd>Fleet home lists every Node you've paired, its tasks, and the agents waiting on you there.</dd>
          </div>
        </dl>
        <a href="/features/nodes/">More about Nodes</a>
      </div>
    </div>
  </section>

  <section class="section faq" aria-labelledby="questions">
    <div class="faq-head">
      <h2 id="questions">Questions</h2>
      <a href="/docs/help/faq/">More in the FAQ</a>
    </div>
    <div class="faq-list">
      {
        faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>
              {item.answer} <a href={item.href}>{item.link}</a>
            </p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section finale closing stage site-dark" aria-labelledby="get-acorn">
    <div class="finale-text">
      <h2 id="get-acorn">Give them a task.</h2>
      <InstallBlock id="footer-install" methods={installMethods} />
      <div class="actions">
        <a class="button" data-variant="primary" data-size="lg" href="/download/">{getAcorn}</a>
        <a class="button" data-size="lg" href="/docs/">Read the docs</a>
      </div>
      <ul class="finale-meta">
        <li><a href="/docs/start/install/">macOS and Windows</a></li>
        <li><a href="/docs/start/desktop-and-terminal/">Terminal client</a></li>
        <li><a href={`${GITHUB}/blob/main/LICENSE`}>MIT license</a></li>
      </ul>
    </div>
    <pre class="finale-art" aria-hidden="true"><span class="cap">{cap}</span>{'\n'}{nut}</pre>
  </section>
</Marketing>

<script>
  import '../scripts/tabs'
</script>

<style>
  :global(.hero) {
    --site-fs-hero: clamp(2.5rem, 1rem + 4.5vw, 5rem);
  }

  .hero-shot {
    display: grid;
    gap: var(--space-10);
  }
  .hero-shot > * {
    margin: 0;
    min-inline-size: 0;
  }

  /* ── Chapters ──
     Each opens with a display heading and a lede. There's no label above the heading, because a caps
     label over every heading is a mark of a generated page. */
  .chapter-head {
    display: grid;
    gap: var(--space-8);
    justify-items: start;
  }
  .chapter-head > * {
    margin: 0;
  }
  .chapter h2,
  .finale h2,
  .faq-head h2 {
    max-inline-size: 18ch;
    font-size: var(--site-fs-display);
    font-weight: var(--fw-bold);
    letter-spacing: var(--site-track-display);
    word-spacing: var(--site-words-display);
    line-height: 1.02;
    overflow-wrap: break-word;
    min-inline-size: 0;
  }
  .chapter h3 {
    margin: 0;
    font-size: var(--fs-xl);
  }

  /* A chapter on its own band runs the subtle background to the window's edges, as the stage does. */
  .band {
    margin-block-start: var(--site-section);
    padding-block: var(--site-section);
    background: var(--bg-subtle);
    border-image: conic-gradient(var(--bg-subtle) 0 0) fill 0 / / 0 100vmax;
  }

  /* ── The lanes ──
     main down the left, and a branch off it for each task, as `git log --graph` draws one turned on its
     side: each lane's rule leaves the trunk in a curve and ends at its branch's head. The rules only
     draw the shape. The words carry it, so the trunk is a grey rule and each head a brass dot. */
  .lanes {
    --trunk: 0.375rem;
    --elbow: clamp(2.5rem, 1rem + 4vw, 5rem);
    --head: 0.75rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-lg);
  }
  .lanes-main {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin: 0;
    font-weight: var(--fw-bold);
  }
  .lanes-main code {
    font-size: var(--site-fs-body);
  }
  .lanes-main::before,
  .lane-branch::before {
    content: '';
    flex: none;
    inline-size: var(--head);
    block-size: var(--head);
    border: var(--bw-strong) solid var(--accent);
    border-radius: 50%;
  }
  .lanes-main::before {
    margin-inline-start: calc(var(--trunk) - var(--head) / 2 + var(--bw-strong) / 2);
    background: var(--bg);
  }
  .lanes ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* A hairline under each lane, from its branch's head to the edge, so the row reads across. */
  .lane {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3) var(--space-11);
    min-block-size: 5rem;
    padding-inline-start: calc(var(--trunk) + var(--elbow));
    background: linear-gradient(var(--border), var(--border)) no-repeat right bottom /
      calc(100% - var(--trunk) - var(--elbow)) var(--bw);
  }
  .lane > * {
    min-inline-size: 0;
  }
  /* The trunk past this lane, and this lane's curve off it. */
  .lane::before,
  .lane:not(:last-child)::after {
    content: '';
    position: absolute;
    inset-inline-start: var(--trunk);
    border-inline-start: var(--bw-strong) solid var(--border-strong);
  }
  .lane::before {
    inset-block: 0 50%;
    inline-size: calc(var(--elbow) - var(--head) / 2);
    border-block-end: var(--bw-strong) solid var(--border-strong);
    border-end-start-radius: var(--radius-xl);
  }
  .lane:not(:last-child)::after {
    inset-block: 0;
  }
  .lane-branch {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-inline-start: calc(-1 * var(--head) / 2);
    font-size: var(--site-fs-body);
    font-weight: var(--fw-bold);
    overflow-wrap: anywhere;
  }
  .lane-branch::before {
    background: var(--accent);
  }
  .lane-title,
  .lane-agent {
    font-size: var(--fs-lg);
  }
  .lane-agent {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
  }
  /* Stacked, a lane's curve meets its branch's name on the first line, not the middle of the lane. */
  @media (max-width: 63.99rem) {
    .lane {
