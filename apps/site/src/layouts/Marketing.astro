---
import 'virtual:acorn-ui.css'
import '../styles/site.css'
import AppearanceScript from '../components/AppearanceScript.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { pageMeta, type PageMeta } from '../meta'

interface Props {
  title: string
  meta: PageMeta
}

const { title, meta } = Astro.props
// A marketing page with a missing or malformed field fails the build, as a docs page does.
pageMeta.parse(meta)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The two faces the first screen draws in. Found only through the stylesheet, they'd start late. -->
    <link rel="preload" href="/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <AppearanceScript />
    <title>{title} · acorn</title>
    <meta name="description" content={meta.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <header class="site-bar"><SiteHeader /></header>
    <main class="site-page">
      {/* A page with a hero lets it carry the page's heading. */}
      {Astro.slots.has('hero') ? <slot name="hero" /> : <h1>{title}</h1>}
      <slot />
    </main>
    <footer class="site-foot"><SiteFooter /></footer>
  </body>
</html>
