---
// Built only in development and on preview deploys. See the `lab` integration in astro.config.mjs.
import { CARDS } from '../og'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lab · acorn</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <h1>Lab</h1>
      <p>
        Wireframes, the design gallery, the specimen gallery, the shell snapshots, and the social cards. Nothing here is
        published to getacorn.dev.
      </p>
      <ul>
        <li><a href="/lab/wireframes/">Wireframes</a></li>
        <li><a href="/lab/design/">Design gallery</a></li>
        <li><a href="/lab/specimens/">Specimens</a></li>
        <li><a href="/lab/snapshots/">Shell snapshots</a></li>
        {Object.keys(CARDS).map((card) => <li><a href={`/lab/og/${card}/`}>Social card: {card}</a></li>)}
      </ul>
    </main>
  </body>
</html>
