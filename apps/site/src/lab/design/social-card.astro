---
// The social card template alone on a 1200 by 630 page, ready for a screenshot: in the theme and style
// pack saved under Appearance on any other page.
import 'virtual:acorn-ui.css'
import '../../styles/site.css'
import AppearanceScript from '../../components/AppearanceScript.astro'
import SocialCard from '../../components/SocialCard.astro'
import { paragraph } from '../wireframes/_landing'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1200" />
    <AppearanceScript />
    <title>Social card · acorn</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <h1 class="sr-only">Social card</h1>
      <SocialCard section="Docs" title="What is acorn" description={paragraph} />
    </main>
  </body>
</html>
