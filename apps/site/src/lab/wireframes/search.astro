---
// The search palette open over a docs page, with results grouped by sidebar section. The page under it
// is the guide wireframe's start, greyed out.
import Docs from './_Docs.astro'

const groups = [
  ['Build plugins', ['Add a pane', 'Put your pane in the right rail', 'Replace the top bar, rail, or pane switcher']],
  ['Reference', ['Contributions: frames, target "pane"', 'Limits: panes per plugin']],
  ['Components', ['Pane', 'Layouts']],
  ['Using acorn', ['Panes', 'The window: top bar, rails, and drawer']],
]
---

<Docs title="Add a pane" section="build" toc={['Before you start', 'Add the manifest entry']}>
  <p>Add a pane to a task's row, drawn from your plugin's tree, in the desktop app and the terminal client.</p>
  <div class="box breakout" style="block-size: 320px">Specimen</div>
  <div class="palette-scrim breakout">
    <div class="palette" role="dialog" aria-label="Search">
      <div class="box" style="place-items: start">pane|</div>
      <p class="tag">Opens with ⌘K, Ctrl+K, or / outside a text field. Escape closes it.</p>
      {
        groups.map(([group, pages]) => (
          <section class="stack">
            <h2>{group}</h2>
            <ul class="stack" style="padding: 0; list-style: none">
              {(pages as string[]).map((page, index) => (
                <li class:list={{ selected: group === 'Build plugins' && index === 0 }}>
                  {page}
                  <br />
                  One line of the page's description, with the match.
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      <p>↑↓ to move · Enter to open · Esc to close</p>
    </div>
  </div>
</Docs>

<style>
  .palette-scrim {
    position: fixed;
    inset: 0;
    display: grid;
    justify-items: center;
    align-items: start;
    padding: 80px 16px 16px;
    background: rgb(0 0 0 / 0.4);
  }
  .palette {
    display: grid;
    gap: 16px;
    inline-size: min(640px, 100%);
    max-block-size: 100%;
    overflow-y: auto;
    padding: 16px;
    background: #fff;
    border: 1px solid #000;
  }
  .selected {
    outline: 2px solid #000;
  }
  @media (max-width: 767px) {
    .palette-scrim {
      padding: 0;
    }
    .palette {
      block-size: 100%;
    }
  }
</style>
