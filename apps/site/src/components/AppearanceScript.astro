---
// Sets the site's theme on <html> before the page draws, so a reload never flashes the other one. The
// site draws in two of acorn's themes, Catppuccin Latte for light and Catppuccin Mocha for dark, and
// always in the Terminal style pack, the default that needs no `data-style`. With no choice saved it
// follows the system's light or dark mode. `data-color-scheme` tells the code blocks which of their two
// syntax themes to draw (ec.config.mjs). Goes early in <head>, inline, so it runs before anything paints.
import appearances from 'virtual:acorn-ui/appearances'

const themes = appearances.site
// An id the app no longer has would leave the site in its plain default colors, so the build stops.
for (const id of Object.values(themes)) {
  if (!appearances.themes.some((theme) => theme.id === id)) throw new Error(`acorn has no theme with the id ${id}.`)
}
---

<script is:inline define:vars={{ themes }}>
  const root = document.documentElement
  const system = matchMedia('(prefers-color-scheme: dark)')
  // Storage can be switched off. Then a choice lasts until the page closes.
  let unsaved = null
  const read = () => {
    try {
      return localStorage.getItem('acorn-scheme')
    } catch {
      return unsaved
    }
  }
  const apply = () => {
    const saved = read()
    const scheme = saved === 'light' || saved === 'dark' ? saved : system.matches ? 'dark' : 'light'
    root.dataset.theme = themes[scheme]
    root.dataset.colorScheme = scheme
  }
  apply()
  system.addEventListener('change', apply)
  window.acornAppearance = {
    /** Switches to the other scheme and saves it. */
    toggle() {
      const scheme = root.dataset.colorScheme === 'dark' ? 'light' : 'dark'
      try {
        localStorage.setItem('acorn-scheme', scheme)
      } catch {
        unsaved = scheme
      }
      apply()
    },
  }
</script>
