---
// A card on the features index and the plugins directory: a title that links, a line or two in the
// default slot, and badges under them.
interface Props {
  title: string
  href: string
}

const { title, href } = Astro.props
---

<article class="card">
  <h3><a href={href}>{title}</a></h3>
  <slot />
  {Astro.slots.has('badges') && <p class="badges"><slot name="badges" /></p>}
</article>
