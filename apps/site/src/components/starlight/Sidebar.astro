---
// Starlight's sidebar, split in two: a Build plugins page sees that section's groups, and every other
// docs page sees the rest. Below Starlight's 50rem breakpoint the sidebar is the page's menu, so it
// also carries the header's links and the light and dark switch.
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro'
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro'
import ThemeToggle from '../ThemeToggle.astro'
import { GITHUB, headerLinks, isBuildPath, sectionOf } from '../../nav'

const { sidebar } = Astro.locals.starlightRoute
type Entry = (typeof sidebar)[number]
const firstHref = (entry: Entry): string => (entry.type === 'link' ? entry.href : firstHref(entry.entries[0]))
const build = isBuildPath(Astro.url.pathname)
const entries = sidebar.filter((entry) => isBuildPath(firstHref(entry)) === build)
const current = sectionOf(Astro.url.pathname)
---

<div class="sidebar-menu">
  <nav aria-label="Site">
    {
      headerLinks.map((link) => (
        <a href={link.href} aria-current={link.id === current ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
    <a href={GITHUB}>Star acorn on GitHub</a>
  </nav>
  <ThemeToggle />
</div>
<SidebarPersister>
  <SidebarSublist sublist={entries} />
</SidebarPersister>
