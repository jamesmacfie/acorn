---
// A whole window or a phone's screen, with nothing drawn around it. The snapshot goes in the slot. The
// caption is for screen readers only, because the picture is inert markup that nothing else describes.
interface Props {
  host: 'desktop' | 'browser' | 'terminal' | 'phone'
  caption: string
}

const { host, caption } = Astro.props
---

<figure class="snapshot frame not-content" data-host={host}>
  <div class="snapshot-body"><slot /></div>
  <figcaption class="sr-only">{caption}</figcaption>
</figure>
