---
// The landing page's feature tour: a tab per feature group, each with a picture, a paragraph, and a
// link. Each tab's picture goes in the slot named for its id. Without script every panel shows.
interface Props {
  tabs: { id: string; label: string; text: string; href: string; link: string }[]
}

const { tabs } = Astro.props
const panels = await Promise.all(tabs.map(async (tab) => ({ ...tab, picture: await Astro.slots.render(tab.id) })))
---

<div class="tour">
  <div class="tabs" role="tablist" aria-label="Features" data-tabs hidden>
    {
      tabs.map((tab) => (
        <button type="button" role="tab" aria-controls={`tour-${tab.id}`}>
          {tab.label}
        </button>
      ))
    }
  </div>
  {
    panels.map((tab) => (
      <div class="tour-panel" id={`tour-${tab.id}`} role="tabpanel" aria-label={tab.label}>
        <div class="tour-picture" set:html={tab.picture} />
        <div class="tour-text">
          <p>{tab.text}</p>
          <a href={tab.href}>{tab.link}</a>
        </div>
      </div>
    ))
  }
</div>

<script>
  import '../scripts/tabs'
</script>
