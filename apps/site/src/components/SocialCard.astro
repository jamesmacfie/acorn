---
// The picture a link to a page shows when someone shares it: 1200 by 630 pixels, drawn at night as the
// stage is, whichever mode the page is in. A screenshot of this component is the card.
import Mark from './Mark.astro'

interface Props {
  /** Where the page sits, such as "Docs" or "Build plugins". */
  section: string
  title: string
  description: string
}

const { section, title, description } = Astro.props
---

<div class="social-card site-dark">
  <p class="eyebrow">{section}</p>
  <p class="social-card-title">{title}</p>
  <p>{description}</p>
  <div class="social-card-foot">
    <Mark />
    <span>getacorn.dev</span>
  </div>
</div>
