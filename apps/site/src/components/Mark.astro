---
// The wordmark: the ASCII acorn the app draws in its empty states, beside the name, both set as text.
// The drawing is read from the app's own component, so the two can't differ.
import source from '@acorn/client-core/kit/components/content/Acorn.tsx?raw'

interface Props {
  /** Where the mark links to. The header's goes home. */
  href?: string
}

const { href = '/' } = Astro.props
const art = source.match(/String\.raw`\n?([\s\S]*?)\n?`/)?.[1]
if (!art) throw new Error('No ASCII acorn found in Acorn.tsx. The wordmark reads it from `String.raw` there.')
---

<a class="site-mark" href={href}>
  <pre aria-hidden="true">{art}</pre>
  <span>acorn</span>
</a>
