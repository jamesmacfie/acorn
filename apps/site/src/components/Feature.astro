---
// One feature: a heading, a paragraph in the default slot, a link into the docs, and its picture, if it
// has one. On a wide screen the picture sits beside the text, on alternate sides down a `.features`
// list, which already gives the order, so the sections carry no numbers.
interface Props {
  title: string
  href: string
  link: string
  /** The heading's level: 3 when the features sit under a section's own heading. */
  level?: 2 | 3
}

const { title, href, link, level = 2 } = Astro.props
const Heading = `h${level}` as const
---

<section class="feature">
  <div class="feature-text">
    <Heading>{title}</Heading>
    <slot />
    <a href={href}>{link}</a>
  </div>
  {Astro.slots.has('picture') && <div class="feature-picture"><slot name="picture" /></div>}
</section>
