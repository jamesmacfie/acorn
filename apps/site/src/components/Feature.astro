---
// One feature: its number, a heading, a paragraph in the default slot, a link into the docs, and its
// picture. On a wide screen the picture sits beside the text, on alternate sides down a `.features` list.
interface Props {
  number: number
  title: string
  href: string
  link: string
}

const { number, title, href, link } = Astro.props
---

<section class="feature">
  <div class="feature-text">
    <p class="eyebrow">{String(number).padStart(2, '0')}</p>
    <h2>{title}</h2>
    <slot />
    <a href={href}>{link}</a>
  </div>
  <div class="feature-picture"><slot name="picture" /></div>
</section>
