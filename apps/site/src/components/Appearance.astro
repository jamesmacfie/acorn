---
// The Appearance control: acorn's themes and style packs, offered as the app's Settings → Appearance
// offers them. A choice restyles the site and every specimen at once, because both read the same
// tokens. AppearanceScript applies and saves it. Without script a choice can't apply, so the control
// stays hidden until its script runs.
import appearances from 'virtual:acorn-ui/appearances'

interface Props {
  /** Unique on the page. The header's control opens a popover with this id. */
  id: string
  /** Draws the two fields in place, with no button, as the narrow-screen docs menu does. */
  inline?: boolean
}

const { id, inline = false } = Astro.props
const { themes, styles, dark } = appearances
const groups = [
  { label: 'Light', themes: themes.filter((theme) => !dark.includes(theme.id)) },
  { label: 'Dark', themes: themes.filter((theme) => dark.includes(theme.id)) },
]
---

<div class="appearance" hidden data-appearance>
  {
    !inline && (
      <button type="button" class="button" popovertarget={id}>
        Appearance
      </button>
    )
  }
  <div class="appearance-fields" id={id} popover={inline ? undefined : ''}>
    <label>
      <span>Theme</span>
      <select data-appearance-key="theme">
        <option value="">Match the system</option>
        {
          groups.map((group) => (
            <optgroup label={group.label}>
              {group.themes.map((theme) => (
                <option value={theme.id}>{theme.label}</option>
              ))}
            </optgroup>
          ))
        }
      </select>
    </label>
    <label>
      <span>Style</span>
      <select data-appearance-key="style">
        {styles.map((style, index) => <option value={index === 0 ? '' : style.id}>{style.label}</option>)}
      </select>
    </label>
  </div>
</div>

<script>
  declare global {
    interface Window {
      acornAppearance: { save(key: 'theme' | 'style', value: string): void }
    }
  }

  const root = document.documentElement
  const selects = [...document.querySelectorAll<HTMLSelectElement>('select[data-appearance-key]')]
  const key = (select: HTMLSelectElement) => select.dataset.appearanceKey as 'theme' | 'style'
  // A page can hold two controls, the header's and the docs menu's, so every select shows what's applied.
  const sync = () => selects.forEach((select) => (select.value = root.dataset[key(select)] ?? ''))
  for (const select of selects) {
    select.addEventListener('change', () => {
      window.acornAppearance.save(key(select), select.value)
      sync()
    })
  }
  sync()
  for (const control of document.querySelectorAll<HTMLElement>('[data-appearance]')) control.hidden = false
</script>
