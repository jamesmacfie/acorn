# Cloudflare applies these to every file the site serves. HTML keeps Cloudflare's default
# `max-age=0, must-revalidate`, so a deploy shows at once.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Astro puts a content hash in every file name here, so a changed file gets a new URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Editors fetch the published JSON Schemas from other origins, so they're open to any.
/schemas/*
  Content-Type: application/json
  Access-Control-Allow-Origin: *
