{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acorn.dev/schemas/v2/capability-v2.schema.json",
  "title": "Acorn V2 capability contracts",
  "oneOf": [
    { "$ref": "#/$defs/rendererAdvertisement" },
    { "$ref": "#/$defs/permissionRequest" },
    { "$ref": "#/$defs/securityGrant" }
  ],
  "$defs": {
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "coordinate": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}/[a-z][a-z0-9-]{1,62}$"
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?:/[1-9][0-9]*)$",
      "maxLength": 160
    },
    "pluginCapabilityId": {
      "allOf": [
        { "$ref": "#/$defs/capabilityId" },
        { "not": { "type": "string", "pattern": "^(?:acorn|core)\\.secret\\.raw/" } }
      ]
    },
    "platformCapabilityId": {
      "allOf": [
        { "$ref": "#/$defs/pluginCapabilityId" },
        {
          "type": "string",
          "pattern": "^(?:acorn|core)\\.(?:workspace|repository|task|worktree|file|git|terminal|process|agent|network|secret|events?|clipboard|notification|storage|provider|ui|plugin|settings|audit|native|docker)(?:[.-][a-z0-9-]+)*/[1-9][0-9]*$"
        }
      ]
    },
    "scopeKind": {
      "enum": [
        "fleet",
        "node",
        "workspace",
        "repository",
        "task",
        "resource",
        "view-session",
        "client-device"
      ]
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/operation" }
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "rendererAdvertisement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "required", "reason", "constraints"],
      "properties": {
        "kind": { "const": "renderer-advertisement" },
        "id": { "$ref": "#/$defs/capabilityId" },
        "revision": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "required": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platforms": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["darwin", "linux", "windows", "ios", "android", "web"] }
            },
            "maxDocumentBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 16777216
            },
            "features": { "$ref": "#/$defs/stringList" }
          }
        }
      }
    },
    "permissionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "scope", "required", "reason", "constraints"],
      "properties": {
        "kind": { "const": "permission-request" },
        "id": { "$ref": "#/$defs/platformCapabilityId" },
        "revision": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "scope": { "$ref": "#/$defs/scopeKind" },
        "required": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "constraints": { "$ref": "#/$defs/securityConstraints" }
      },
      "allOf": [{ "$ref": "#/$defs/familyBinding" }]
    },
    "securityGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "grantId",
        "grantGeneration",
        "plugin",
        "capability",
        "scope",
        "constraints",
        "permissionRequestDigest",
        "grantVersion",
        "status",
        "approvedBy",
        "approvedAt",
        "expiresAt",
        "reviewAt",
        "revocation"
      ],
      "properties": {
        "kind": { "const": "security-grant" },
        "grantId": { "$ref": "#/$defs/uuidv7" },
        "grantGeneration": { "$ref": "#/$defs/decimal" },
        "plugin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coordinate",
            "publisherKeyId",
            "installationId",
            "installationGeneration",
            "artifactDigest"
          ],
          "properties": {
            "coordinate": { "$ref": "#/$defs/coordinate" },
            "publisherKeyId": { "type": "string", "minLength": 8, "maxLength": 200 },
            "installationId": { "$ref": "#/$defs/uuidv7" },
            "installationGeneration": { "$ref": "#/$defs/decimal" },
            "artifactDigest": { "$ref": "#/$defs/digest" }
          }
        },
        "capability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "revision", "operations"],
          "properties": {
            "id": { "$ref": "#/$defs/platformCapabilityId" },
            "revision": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
            "operations": { "$ref": "#/$defs/operations" }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "resourceSelector"],
          "properties": {
            "kind": { "$ref": "#/$defs/scopeKind" },
            "resourceSelector": {
              "type": "object",
              "additionalProperties": false,
              "required": ["uris"],
              "properties": {
                "uris": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 256,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^acorn://[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/[a-z][a-z0-9.-]*/(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|\\*)$"
                  }
                }
              }
            }
          }
        },
        "constraints": { "$ref": "#/$defs/securityConstraints" },
        "permissionRequestDigest": { "$ref": "#/$defs/digest" },
        "grantVersion": { "$ref": "#/$defs/decimal" },
        "status": { "enum": ["pending", "active", "expired", "revoked", "superseded"] },
        "approvedBy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["device", "system"] },
            "id": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "approvedAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "reviewAt": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "revocation": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["revokedAt", "revokedBy", "reason"],
              "properties": {
                "revokedAt": { "$ref": "#/$defs/timestamp" },
                "revokedBy": { "type": "string", "minLength": 1, "maxLength": 200 },
                "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/grantFamilyBinding"
        }
      ]
    },
    "securityConstraints": {
      "oneOf": [
        { "$ref": "#/$defs/workspaceConstraints" },
        { "$ref": "#/$defs/repositoryConstraints" },
        { "$ref": "#/$defs/taskConstraints" },
        { "$ref": "#/$defs/worktreeConstraints" },
        { "$ref": "#/$defs/fileConstraints" },
        { "$ref": "#/$defs/gitConstraints" },
        { "$ref": "#/$defs/terminalConstraints" },
        { "$ref": "#/$defs/processConstraints" },
        { "$ref": "#/$defs/agentConstraints" },
        { "$ref": "#/$defs/networkConstraints" },
        { "$ref": "#/$defs/secretConstraints" },
        { "$ref": "#/$defs/eventConstraints" },
        { "$ref": "#/$defs/clipboardConstraints" },
        { "$ref": "#/$defs/notificationConstraints" },
        { "$ref": "#/$defs/storageConstraints" },
        { "$ref": "#/$defs/providerConstraints" },
        { "$ref": "#/$defs/uiConstraints" },
        { "$ref": "#/$defs/pluginConstraints" },
        { "$ref": "#/$defs/settingsConstraints" },
        { "$ref": "#/$defs/auditConstraints" },
        { "$ref": "#/$defs/nativeConstraints" },
        { "$ref": "#/$defs/dockerConstraints" }
      ]
    },
    "workspaceConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "operations"],
      "properties": {
        "family": { "const": "workspace" },
        "operations": { "$ref": "#/$defs/operations" }
      }
    },
    "repositoryConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "operations", "repositorySelectors"],
      "properties": {
        "family": { "const": "repository" },
        "operations": { "$ref": "#/$defs/operations" },
        "repositorySelectors": { "$ref": "#/$defs/stringList" }
      }
    },
    "taskConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "operations", "taskTypes"],
      "properties": {
        "family": { "const": "task" },
        "operations": { "$ref": "#/$defs/operations" },
        "taskTypes": { "$ref": "#/$defs/stringList" }
      }
    },
    "worktreeConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family", "operations", "repositorySelectors", "pathMode",
        "allowDirtyRemoval", "openAfterCreate"
      ],
      "properties": {
        "family": { "const": "worktree" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["list", "read", "create", "open", "adopt", "remove"] }
        },
        "repositorySelectors": { "$ref": "#/$defs/stringList" },
        "pathMode": { "const": "core-managed-only" },
        "allowDirtyRemoval": { "type": "boolean" },
        "openAfterCreate": { "type": "boolean" }
      }
    },
    "fileConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "operations", "pathGlobs", "followSymlinks"],
      "properties": {
        "family": { "const": "file" },
        "operations": { "$ref": "#/$defs/operations" },
        "pathGlobs": { "$ref": "#/$defs/stringList" },
        "followSymlinks": { "type": "boolean" }
      }
    },
    "gitConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "operations"],
      "properties": {
        "family": { "const": "git" },
        "operations": { "$ref": "#/$defs/operations" }
      }
    },
    "terminalConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "operations", "allowInput"],
      "properties": {
        "family": { "const": "terminal" },
        "operations": { "$ref": "#/$defs/operations" },
        "allowInput": { "type": "boolean" }
      }
    },
    "processConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "operations", "executableDigests", "shell", "children"],
      "properties": {
        "family": { "const": "process" },
        "operations": { "$ref": "#/$defs/operations" },
        "executableDigests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        },
        "shell": { "type": "boolean" },
        "children": { "type": "boolean" }
      }
    },
    "agentConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "operations", "profiles"],
      "properties": {
        "family": { "const": "agent" },
        "operations": { "$ref": "#/$defs/operations" },
        "profiles": { "$ref": "#/$defs/stringList" }
      }
    },
    "networkConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "operations", "schemes", "hosts", "ports", "pathPrefixes", "allowPrivate"],
      "properties": {
        "family": { "const": "network" },
        "operations": { "$ref": "#/$defs/operations" },
        "schemes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["https", "wss"] }
        },
        "hosts": { "$ref": "#/$defs/stringList" },
        "ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "pathPrefixes": { "$ref": "#/$defs/stringList" },
        "allowPrivate": { "type": "boolean" }
      }
    },
    "secretConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "operations", "secretRefs", "purpose", "brokerOnly"],
      "properties": {
        "family": { "const": "secret" },
        "operations": { "$ref": "#/$defs/operations" },
        "secretRefs": { "$ref": "#/$defs/stringList" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 200 },
        "brokerOnly": { "const": true }
      }
    },
    "eventConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family", "operations", "eventTypes", "resourcePrefixes",
        "maximumSensitivity"
      ],
      "properties": {
        "family": { "const": "event" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["subscribe", "replay", "snapshot", "publish"] }
        },
        "eventTypes": { "$ref": "#/$defs/stringList" },
        "resourcePrefixes": { "$ref": "#/$defs/stringList" },
        "maximumSensitivity": {
          "enum": ["public-metadata", "internal", "sensitive"]
        }
      }
    },
    "clipboardConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "operations", "formats", "userGestureRequired"],
      "properties": {
        "family": { "const": "clipboard" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["read", "write"] }
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "enum": ["text/plain", "text/uri-list", "image/png"] }
        },
        "userGestureRequired": { "type": "boolean" }
      }
    },
    "notificationConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "operations", "categories", "maximumPerMinute"],
      "properties": {
        "family": { "const": "notification" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["create", "update", "dismiss"] }
        },
        "categories": { "$ref": "#/$defs/stringList" },
        "maximumPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "storageConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "operations", "maximumBytes", "classes"],
      "properties": {
        "family": { "const": "storage" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["read", "write", "delete", "scan", "migrate"] }
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10737418240
        },
        "classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["sqlite", "blob", "cache", "index"] }
        }
      }
    },
    "providerConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family", "operations", "providers", "destinations", "purposes",
        "brokerOnly"
      ],
      "properties": {
        "family": { "const": "provider" },
        "operations": { "$ref": "#/$defs/operations" },
        "providers": { "$ref": "#/$defs/stringList" },
        "destinations": { "$ref": "#/$defs/stringList" },
        "purposes": { "$ref": "#/$defs/stringList" },
        "brokerOnly": { "const": true }
      }
    },
    "uiConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "operations", "contributions"],
      "properties": {
        "family": { "const": "ui" },
        "operations": { "$ref": "#/$defs/operations" },
        "contributions": { "$ref": "#/$defs/stringList" }
      }
    },
    "pluginConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "operations", "coordinates", "contracts", "events"],
      "properties": {
        "family": { "const": "plugin" },
        "operations": { "$ref": "#/$defs/operations" },
        "coordinates": { "$ref": "#/$defs/stringList" },
        "contracts": { "$ref": "#/$defs/stringList" },
        "events": { "$ref": "#/$defs/stringList" }
      }
    },
    "settingsConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "operations", "keys"],
      "properties": {
        "family": { "const": "settings" },
        "operations": { "$ref": "#/$defs/operations" },
        "keys": { "$ref": "#/$defs/stringList" }
      }
    },
    "auditConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "operations"],
      "properties": {
        "family": { "const": "audit" },
        "operations": { "$ref": "#/$defs/operations" }
      }
    },
    "nativeConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "operations", "sandboxProfiles"],
      "properties": {
        "family": { "const": "native" },
        "operations": { "$ref": "#/$defs/operations" },
        "sandboxProfiles": { "$ref": "#/$defs/stringList" }
      }
    },
    "dockerConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "operations", "composeSnapshotDigest", "highRiskEffects"],
      "properties": {
        "family": { "const": "docker" },
        "operations": { "$ref": "#/$defs/operations" },
        "composeSnapshotDigest": {
          "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        },
        "highRiskEffects": { "$ref": "#/$defs/stringList" }
      }
    },
    "familyBinding": {
      "allOf": [
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.workspace(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/workspaceConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.repository(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/repositoryConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.task(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/taskConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.worktree(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/worktreeConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.file(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/fileConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.git(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/gitConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.terminal(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/terminalConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.process(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/processConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.agent(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/agentConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.network(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/networkConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.secret(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/secretConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.events?(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/eventConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.clipboard(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/clipboardConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.notification(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/notificationConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.storage(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/storageConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.provider(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/providerConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.ui(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/uiConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.plugin(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/pluginConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.settings(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/settingsConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.audit(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/auditConstraints" } } } },
        { "if": { "properties": { "id": { "pattern": "^(?:acorn|core)\\.native(?:[.-]|/)" } } }, "then": { "properties": { "constraints": { "$ref": "#/$defs/nativeConstraints" } } } },
