{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acorn.dev/schemas/v2/audit-envelope-v2.schema.json",
  "title": "Acorn V2 security audit artifacts",
  "oneOf": [
    { "$ref": "#/$defs/record" },
    { "$ref": "#/$defs/checkpoint" },
    { "$ref": "#/$defs/retainedRange" }
  ],
  "$defs": {
    "uuidv7": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "authenticator": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["device", "system", "plugin", "agent", "local-administrator"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "delegationHop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installationId", "installationGeneration", "grantId", "grantVersion"],
      "properties": {
        "installationId": { "$ref": "#/$defs/uuidv7" },
        "installationGeneration": { "$ref": "#/$defs/decimal" },
        "grantId": { "$ref": "#/$defs/uuidv7" },
        "grantVersion": { "$ref": "#/$defs/decimal" }
      }
    },
    "grantVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grantId", "grantVersion"],
      "properties": {
        "grantId": { "$ref": "#/$defs/uuidv7" },
        "grantVersion": { "$ref": "#/$defs/decimal" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion", "kind", "auditId", "nodeId", "auditSequence", "keyEpoch",
        "occurredAt", "monotonicOffsetNs", "category", "eventType", "outcome",
        "actor", "delegation", "targets", "requestId", "policyVersion",
        "grantVersions", "reasonCode", "safeMetadata", "previousAuthenticator", "authenticator"
      ],
      "properties": {
        "apiVersion": { "const": "acorn.dev/audit/v2" },
        "kind": { "const": "record" },
        "auditId": { "$ref": "#/$defs/uuidv7" },
        "nodeId": { "$ref": "#/$defs/uuidv7" },
        "auditSequence": { "$ref": "#/$defs/decimal" },
        "keyEpoch": { "$ref": "#/$defs/decimal" },
        "occurredAt": { "$ref": "#/$defs/timestamp" },
        "monotonicOffsetNs": { "$ref": "#/$defs/decimal" },
        "category": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,99}$" },
        "eventType": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,159}$" },
        "outcome": { "enum": ["allowed", "denied", "failed", "cancelled", "completed"] },
        "actor": { "$ref": "#/$defs/actor" },
        "delegation": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/delegationHop" }
        },
        "targets": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "requestId": { "oneOf": [{ "$ref": "#/$defs/uuidv7" }, { "type": "null" }] },
        "policyVersion": { "$ref": "#/$defs/decimal" },
        "grantVersions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/grantVersion" }
        },
        "reasonCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,99}$" },
        "safeMetadata": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "oneOf": [
              { "type": "string", "maxLength": 500 },
              { "type": "integer" },
              { "type": "boolean" },
              { "type": "null" }
            ]
          }
        },
        "previousAuthenticator": {
          "oneOf": [{ "$ref": "#/$defs/authenticator" }, { "type": "null" }]
        },
        "authenticator": { "$ref": "#/$defs/authenticator" }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion", "kind", "nodeId", "keyEpoch", "checkpointSequence",
        "firstSequence", "lastSequence", "finalAuthenticator", "policyVersion",
        "createdAt", "signingKeyId", "signature"
      ],
      "properties": {
        "apiVersion": { "const": "acorn.dev/audit/v2" },
        "kind": { "const": "checkpoint" },
        "nodeId": { "$ref": "#/$defs/uuidv7" },
        "keyEpoch": { "$ref": "#/$defs/decimal" },
        "checkpointSequence": { "$ref": "#/$defs/decimal" },
        "firstSequence": { "$ref": "#/$defs/decimal" },
        "lastSequence": { "$ref": "#/$defs/decimal" },
        "finalAuthenticator": { "$ref": "#/$defs/authenticator" },
        "policyVersion": { "$ref": "#/$defs/decimal" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "signingKeyId": { "type": "string", "minLength": 8, "maxLength": 200 },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "retainedRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion", "kind", "nodeId", "rangeId", "firstDeletedSequence",
        "lastDeletedSequence", "firstOccurredAt", "lastOccurredAt",
        "priorCheckpointSequence", "authorizedBy", "deletedAt", "reason",
        "markerAuthenticator", "signingKeyId", "signature"
      ],
      "properties": {
        "apiVersion": { "const": "acorn.dev/audit/v2" },
        "kind": { "const": "retained-range" },
        "nodeId": { "$ref": "#/$defs/uuidv7" },
        "rangeId": { "$ref": "#/$defs/uuidv7" },
        "firstDeletedSequence": { "$ref": "#/$defs/decimal" },
        "lastDeletedSequence": { "$ref": "#/$defs/decimal" },
        "firstOccurredAt": { "$ref": "#/$defs/timestamp" },
        "lastOccurredAt": { "$ref": "#/$defs/timestamp" },
        "priorCheckpointSequence": { "$ref": "#/$defs/decimal" },
        "authorizedBy": { "$ref": "#/$defs/actor" },
        "deletedAt": { "$ref": "#/$defs/timestamp" },
        "reason": { "enum": ["retention-time", "retention-size", "owner-extended-policy"] },
        "markerAuthenticator": { "$ref": "#/$defs/authenticator" },
        "signingKeyId": { "type": "string", "minLength": 8, "maxLength": 200 },
        "signature": { "$ref": "#/$defs/signature" }
      }
    }
  }
}
