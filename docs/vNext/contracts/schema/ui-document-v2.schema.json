{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acorn.dev/schemas/v2/ui-document-v2.schema.json",
  "title": "Acorn V2 declarative UI document",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "documentId", "viewSession", "revision", "title", "root"],
  "properties": {
    "apiVersion": { "const": "acorn.dev/ui-document/v2" },
    "documentId": { "$ref": "#/$defs/uuidv7" },
    "viewSession": { "$ref": "#/$defs/acornUri" },
    "revision": { "$ref": "#/$defs/decimal" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "accessibilityLabel": { "type": "string", "minLength": 1, "maxLength": 200 },
    "root": { "$ref": "#/$defs/node" }
  },
  "$defs": {
    "uuidv7": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "acornUri": { "type": "string", "pattern": "^acorn://[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/[a-z][a-z0-9.-]*/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "renderer", "props", "bindings", "actions", "children"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
        "renderer": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?:/[1-9][0-9]*)$", "maxLength": 160 },
        "props": { "type": "object", "maxProperties": 128 },
        "bindings": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9]*$", "maxLength": 64 },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "path"],
            "properties": {
              "source": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
              "path": { "type": "string", "pattern": "^(?:/[A-Za-z0-9_-]+)*$", "maxLength": 500 }
            }
          }
        },
        "actions": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9]*$", "maxLength": 64 },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "input"],
            "properties": {
              "action": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:[.-][a-z0-9-]+)+$", "maxLength": 200 },
              "input": { "type": "object", "maxProperties": 64 },
              "confirmation": { "enum": ["none", "destructive", "credential", "native-execution"] }
            }
          }
        },
        "children": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/node" }
        }
      }
    }
  }
}
