{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acorn.dev/schemas/v2/contribution-fixture-set-v2.schema.json",
  "title": "Acorn V2 contribution fixture set",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "contributions"],
  "properties": {
    "apiVersion": { "const": "acorn.dev/contribution-fixtures/v2" },
    "contributions": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": { "$ref": "contribution-v2.schema.json" }
    }
  }
}
