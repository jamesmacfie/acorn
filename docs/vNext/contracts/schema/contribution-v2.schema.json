{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acorn.dev/schemas/v2/contribution-v2.schema.json",
  "title": "Acorn V2 plugin contribution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "type", "artifact", "capabilityVersion", "label", "description",
    "order", "when", "requires", "fallback", "definition"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/localId" },
    "type": {
      "enum": [
        "fleet-source", "workspace-source", "task-pane", "route", "command", "keybinding",
        "context-menu", "shell-slot", "task-slot", "settings-page", "wizard", "notice-kind",
        "notification", "attention-item", "badge", "poller", "subscription",
        "background-worker", "query", "action", "context-section", "agent-tool-renderer",
        "navigation-intent", "client-presentation", "source-promotion", "renderer-provider",
        "theme", "style"
      ]
    },
    "artifact": { "$ref": "#/$defs/localId" },
    "capabilityVersion": { "const": "2.0" },
    "label": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 240 },
        { "type": "null" }
      ]
    },
    "order": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
    "when": {
      "oneOf": [{ "$ref": "#/$defs/predicate" }, { "type": "null" }]
    },
    "requires": { "$ref": "#/$defs/requirements" },
    "fallback": { "$ref": "#/$defs/fallback" },
    "definition": { "$ref": "#/$defs/definition" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "enum": ["fleet-source", "workspace-source"] } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/source" } } } },
    { "if": { "properties": { "type": { "const": "task-pane" } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/taskPane" } } } },
    { "if": { "properties": { "type": { "const": "route" } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/route" } } } },
    { "if": { "properties": { "type": { "const": "command" } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/command" } } } },
    { "if": { "properties": { "type": { "const": "keybinding" } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/keybinding" } } } },
    { "if": { "properties": { "type": { "const": "context-menu" } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/contextMenu" } } } },
    { "if": { "properties": { "type": { "enum": ["shell-slot", "task-slot"] } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/slot" } } } },
    { "if": { "properties": { "type": { "const": "settings-page" } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/settingsPage" } } } },
    { "if": { "properties": { "type": { "const": "wizard" } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/wizard" } } } },
    { "if": { "properties": { "type": { "const": "notice-kind" } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/noticeKind" } } } },
    { "if": { "properties": { "type": { "const": "notification" } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/notification" } } } },
    { "if": { "properties": { "type": { "const": "attention-item" } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/attention" } } } },
    { "if": { "properties": { "type": { "const": "badge" } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/badge" } } } },
    { "if": { "properties": { "type": { "enum": ["poller", "subscription", "background-worker"] } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/worker" } } } },
    { "if": { "properties": { "type": { "enum": ["query", "action"] } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/operation" } } } },
    { "if": { "properties": { "type": { "const": "context-section" } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/contextSection" } } } },
    { "if": { "properties": { "type": { "const": "agent-tool-renderer" } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/agentToolRenderer" } } } },
    { "if": { "properties": { "type": { "const": "navigation-intent" } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/navigationIntent" } } } },
    { "if": { "properties": { "type": { "const": "client-presentation" } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/clientPresentation" } } } },
    { "if": { "properties": { "type": { "const": "source-promotion" } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/sourcePromotion" } } } },
    { "if": { "properties": { "type": { "const": "renderer-provider" } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/rendererProvider" } } } },
    { "if": { "properties": { "type": { "enum": ["theme", "style"] } } }, "then": { "properties": { "definition": { "$ref": "#/$defs/appearance" } } } }
  ],
  "$defs": {
    "localId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "namespacedId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:[.-][a-z0-9-]+)+\\.v[1-9][0-9]*$",
      "maxLength": 200
    },
    "rendererId": {
      "type": "string",
      "pattern": "^acorn\\.[a-z][a-z0-9-]*/[1-9][0-9]*$",
      "maxLength": 160
    },
    "schemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest"],
      "properties": {
        "uri": { "type": "string", "format": "uri", "maxLength": 500 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all"],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "operator", "value"],
            "properties": {
              "field": {
                "enum": [
                  "client.platform", "client.sizeClass", "node.connectionState",
                  "workspace.present", "task.present", "task.archived",
                  "selection.kind", "view.visible", "renderer.supported"
                ]
              },
              "operator": { "enum": ["equals", "not-equals", "in", "present"] },
              "value": {
                "oneOf": [
                  { "type": "string", "maxLength": 160 },
                  { "type": "boolean" },
                  {
                    "type": "array",
                    "maxItems": 16,
                    "items": { "type": "string", "maxLength": 160 }
                  },
                  { "type": "null" }
                ]
              }
            }
          }
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencies", "grants", "rendererCapabilities", "rendererNodes"],
      "properties": {
        "dependencies": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}/[a-z][a-z0-9-]{1,62}$" }
        },
        "grants": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namespacedId" }
        },
        "rendererCapabilities": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/rendererId" }
        },
        "rendererNodes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/rendererId" }
        }
      }
    },
    "fallback": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "contributionId"],
          "properties": {
            "kind": { "const": "contribution" },
            "contributionId": { "$ref": "#/$defs/localId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "desktop", "mobile", "reason"],
          "properties": {
            "kind": { "const": "unsupported" },
            "desktop": { "enum": ["hidden", "disabled", "placeholder", "unsupported-screen"] },
            "mobile": { "enum": ["semantic", "read-only", "unsupported"] },
            "reason": { "type": "string", "minLength": 1, "maxLength": 240 }
          }
        }
      ]
    },
    "definition": {
      "oneOf": [
        { "$ref": "#/$defs/source" }, { "$ref": "#/$defs/taskPane" },
        { "$ref": "#/$defs/route" }, { "$ref": "#/$defs/command" },
        { "$ref": "#/$defs/keybinding" }, { "$ref": "#/$defs/contextMenu" },
        { "$ref": "#/$defs/slot" }, { "$ref": "#/$defs/settingsPage" },
        { "$ref": "#/$defs/wizard" }, { "$ref": "#/$defs/noticeKind" },
        { "$ref": "#/$defs/notification" }, { "$ref": "#/$defs/attention" },
        { "$ref": "#/$defs/badge" }, { "$ref": "#/$defs/worker" },
        { "$ref": "#/$defs/operation" }, { "$ref": "#/$defs/contextSection" },
        { "$ref": "#/$defs/agentToolRenderer" }, { "$ref": "#/$defs/navigationIntent" },
        { "$ref": "#/$defs/clientPresentation" }, { "$ref": "#/$defs/sourcePromotion" },
        { "$ref": "#/$defs/rendererProvider" },
        { "$ref": "#/$defs/appearance" }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "icon", "route", "view"],
      "properties": {
        "kind": { "enum": ["fleet-source", "workspace-source"] },
        "icon": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "route": { "$ref": "#/$defs/localId" },
        "view": { "$ref": "#/$defs/localId" }
      }
    },
    "taskPane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "icon", "view", "minimumWidth", "retention"],
      "properties": {
        "kind": { "const": "task-pane" },
        "icon": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "view": { "$ref": "#/$defs/localId" },
        "dataQuery": { "$ref": "#/$defs/namespacedId" },
        "minimumWidth": { "type": "integer", "minimum": 160, "maximum": 2400 },
        "retention": { "enum": ["none", "session", "dom"] }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pathTemplate", "view", "scope"],
      "properties": {
        "kind": { "const": "route" },
        "pathTemplate": { "type": "string", "pattern": "^/[a-z][a-z0-9-/]*(?::[a-z][a-zA-Z0-9]*)?$", "maxLength": 200 },
        "view": { "$ref": "#/$defs/localId" },
        "scope": { "enum": ["fleet", "node", "workspace", "task"] }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "category", "target", "inputAcquisition", "resourceScope", "repeatable", "confirmation"],
      "properties": {
        "kind": { "const": "command" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "target": { "$ref": "#/$defs/namespacedId" },
        "inputAcquisition": { "enum": ["none", "active-resource", "selection", "host-form", "view-binding"] },
        "resourceScope": { "enum": ["fleet", "node", "workspace", "repository", "task", "resource", "view-session"] },
        "repeatable": { "type": "boolean" },
        "confirmation": { "enum": ["none", "risk", "destructive", "credential", "native-execution", "unrestricted-code"] }
      }
    },
    "keybinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "scope", "defaultChord"],
      "properties": {
        "kind": { "const": "keybinding" },
        "command": { "$ref": "#/$defs/localId" },
        "scope": { "enum": ["global", "fleet", "workspace", "task", "pane", "typing-exempt"] },
        "defaultChord": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "contextMenu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "menu", "group", "selectionTypes"],
      "properties": {
        "kind": { "const": "context-menu" },
        "command": { "$ref": "#/$defs/localId" },
        "menu": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,99}$" },
        "group": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,99}$" },
        "selectionTypes": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,99}$" } }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "slot", "view", "modality", "dismissal", "focusReturn"],
      "properties": {
        "kind": { "enum": ["shell-slot", "task-slot"] },
        "slot": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,99}$" },
        "view": { "$ref": "#/$defs/localId" },
        "modality": { "enum": ["none", "non-modal", "modal"] },
        "dismissal": { "enum": ["host", "user", "command"] },
        "focusReturn": { "enum": ["invoker", "pane", "shell"] }
      }
    },
    "settingsPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "scope", "schema", "view"],
      "properties": {
        "kind": { "const": "settings-page" },
        "scope": { "enum": ["fleet-owner", "node", "workspace", "repository", "task", "installation", "client-device"] },
        "schema": { "$ref": "#/$defs/schemaRef" },
        "view": { "$ref": "#/$defs/localId" }
      }
    },
    "wizard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "wizardId"],
      "properties": {
        "kind": { "const": "wizard" },
        "wizardId": { "$ref": "#/$defs/localId" }
      }
    },
    "noticeKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "severity", "icon", "toastPolicy"],
      "properties": {
        "kind": { "const": "notice-kind" },
        "severity": { "enum": ["info", "success", "warning", "error", "critical"] },
        "icon": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "toastPolicy": { "enum": ["never", "foreground", "always"] }
      }
    },
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "event", "severity", "renderer", "deduplicationField", "privacy", "expirationSeconds", "toastPolicy", "targetIntent", "actions"],
      "properties": {
        "kind": { "const": "notification" },
        "event": { "$ref": "#/$defs/namespacedId" },
        "severity": { "enum": ["info", "success", "warning", "error", "critical"] },
        "renderer": { "$ref": "#/$defs/rendererId" },
        "deduplicationField": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9.]{0,99}$" },
        "privacy": { "enum": ["public-metadata", "internal", "sensitive"] },
        "expirationSeconds": { "type": "integer", "minimum": 1, "maximum": 604800 },
        "toastPolicy": { "enum": ["never", "foreground", "always"] },
        "targetIntent": { "$ref": "#/$defs/localId" },
        "actions": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/localId" } }
      }
    },
    "attention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "snapshotQuery", "events", "actions"],
      "properties": {
        "kind": { "const": "attention-item" },
        "snapshotQuery": { "$ref": "#/$defs/namespacedId" },
        "events": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/namespacedId" } },
        "actions": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/localId" } }
      }
    },
    "badge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "anchor", "valueBinding", "toneMap", "textAlternative", "aggregation", "displayCap", "staleBehavior"],
      "properties": {
        "kind": { "const": "badge" },
        "anchor": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,99}$" },
        "valueBinding": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9.]{0,99}$" },
        "toneMap": { "type": "object", "maxProperties": 8, "additionalProperties": { "enum": ["neutral", "accent", "success", "warning", "danger", "info", "muted"] } },
        "textAlternative": { "type": "string", "minLength": 1, "maxLength": 160 },
        "aggregation": { "enum": ["none", "sum", "maximum", "any"] },
        "displayCap": { "type": "integer", "minimum": 1, "maximum": 9999 },
        "staleBehavior": { "enum": ["hide", "mark-stale", "retain-last"] }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "worker"],
      "properties": {
        "kind": { "enum": ["poller", "subscription", "background-worker"] },
        "worker": { "$ref": "worker-v2.schema.json" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operation", "inputSchema", "outputSchema"],
      "properties": {
        "kind": { "enum": ["query", "action"] },
        "operation": { "$ref": "#/$defs/namespacedId" },
        "inputSchema": { "$ref": "#/$defs/schemaRef" },
        "outputSchema": { "$ref": "#/$defs/schemaRef" }
      }
    },
    "contextSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "snapshotQuery", "maximumBytes", "maximumTokens", "sensitivity"],
      "properties": {
        "kind": { "const": "context-section" },
        "snapshotQuery": { "$ref": "#/$defs/namespacedId" },
        "maximumBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "maximumTokens": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "sensitivity": { "enum": ["public-metadata", "internal", "sensitive"] }
      }
    },
    "agentToolRenderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "toolSchema", "view", "genericFallback"],
      "properties": {
        "kind": { "const": "agent-tool-renderer" },
        "toolSchema": { "$ref": "#/$defs/schemaRef" },
        "view": { "$ref": "#/$defs/localId" },
        "genericFallback": { "const": true }
      }
    },
    "navigationIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "patterns", "destination", "externalPolicy", "collisionPolicy"
      ],
      "properties": {
        "kind": { "const": "navigation-intent" },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["template", "queryPolicy"],
            "properties": {
              "template": {
                "type": "string",
                "pattern": "^(?:[a-z][a-z0-9+.-]{0,15}://(?:[a-z0-9.-]{1,253}|\\[::1\\])(?::(?:[1-9][0-9]{0,4}|\\{[a-z][a-zA-Z0-9]{0,31}:port\\}))?/(?:[A-Za-z0-9._~-]+|\\{[a-z][a-zA-Z0-9]{0,31}:(?:uuidv7|integer|slug|path-segment|path-tail)\\})(?:/(?:[A-Za-z0-9._~-]+|\\{[a-z][a-zA-Z0-9]{0,31}:(?:uuidv7|integer|slug|path-segment|path-tail)\\}))*|[a-z][a-z0-9+.-]{0,15}://(?:[a-z0-9.-]{1,253}|\\[::1\\])(?::(?:[1-9][0-9]{0,4}|\\{[a-z][a-zA-Z0-9]{0,31}:port\\}))?/|[a-z][a-z0-9+.-]{0,15}:/(?:[A-Za-z0-9._~-]+|\\{[a-z][a-zA-Z0-9]{0,31}:(?:uuidv7|integer|slug|path-segment|path-tail)\\})(?:/(?:[A-Za-z0-9._~-]+|\\{[a-z][a-zA-Z0-9]{0,31}:(?:uuidv7|integer|slug|path-segment|path-tail)\\}))*)$",
                "maxLength": 300
              },
              "queryPolicy": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "allowedKeys", "captures"],
                "properties": {
                  "mode": { "enum": ["reject", "ignore", "allowlisted"] },
                  "allowedKeys": {
                    "type": "array",
                    "maxItems": 16,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
                    }
                  },
                  "captures": {
                    "type": "object",
                    "maxProperties": 16,
                    "propertyNames": {
                      "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
                    },
                    "additionalProperties": {
                      "enum": ["uuidv7", "integer", "slug", "path-segment", "opaque-token"]
                    }
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": { "mode": { "const": "allowlisted" } }
                    },
                    "then": {
                      "properties": {
                        "allowedKeys": { "minItems": 1 },
                        "captures": { "minProperties": 1 }
                      }
                    },
                    "else": {
                      "properties": {
                        "allowedKeys": { "maxItems": 0 },
                        "captures": { "maxProperties": 0 }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "destination": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "resourceType", "captureMapping"],
              "properties": {
                "kind": { "const": "resource" },
                "resourceType": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{0,99}$"
                },
                "captureMapping": { "$ref": "#/$defs/captureMapping" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "command", "inputMapping"],
              "properties": {
                "kind": { "const": "client-command" },
                "command": { "$ref": "#/$defs/namespacedId" },
                "inputMapping": { "$ref": "#/$defs/captureMapping" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "command", "inputMapping", "confirmation"],
              "properties": {
                "kind": { "const": "node-command" },
                "command": { "$ref": "#/$defs/namespacedId" },
                "inputMapping": { "$ref": "#/$defs/captureMapping" },
                "confirmation": {
                  "enum": ["always", "effect-policy", "never-for-read-only"]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "routeContributionId", "parameterMapping"],
              "properties": {
                "kind": { "const": "route" },
                "routeContributionId": { "$ref": "#/$defs/localId" },
                "parameterMapping": { "$ref": "#/$defs/captureMapping" }
              }
            }
          ]
        },
        "externalPolicy": {
          "enum": ["internal-only", "confirm-system-browser", "copy-only"]
        },
        "collisionPolicy": { "const": "reject-install" }
      }
    },
    "captureMapping": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?:\\$capture\\.[a-z][a-zA-Z0-9]{0,31}|\\$target\\.uri)$"
      }
    },
    "clientPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subscriptions", "slices", "automations"],
      "properties": {
        "kind": { "const": "client-presentation" },
        "subscriptions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "enum": [
              "workspace-focused", "task-focused", "pane-focused", "pane-opened",
              "pane-closed", "pane-moved", "layout-changed",
              "terminal-session-focused", "terminal-session-closed"
            ]
          }
        },
        "slices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id", "sourceEvents", "reducer", "capacity", "maximumBytes",
              "persistence", "privacy", "disableBehavior", "uninstallBehavior"
            ],
            "properties": {
              "id": { "$ref": "#/$defs/localId" },
              "sourceEvents": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "workspace-focused", "task-focused", "pane-focused",
                    "pane-opened", "pane-closed", "pane-moved", "layout-changed",
                    "terminal-session-focused", "terminal-session-closed"
                  ]
                }
              },
              "reducer": {
                "enum": ["last-value", "recent-distinct", "bounded-count"]
              },
              "capacity": { "type": "integer", "minimum": 1, "maximum": 256 },
              "maximumBytes": {
                "type": "integer",
                "minimum": 256,
                "maximum": 1048576
              },
              "persistence": { "enum": ["session", "client-device"] },
              "privacy": { "const": "client-local-only" },
              "disableBehavior": { "enum": ["freeze", "clear"] },
              "uninstallBehavior": { "const": "clear" }
            }
          }
        },
        "automations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id", "trigger", "clientCommand", "debounceMs",
              "ownerApproval", "inputMapping"
            ],
            "properties": {
              "id": { "$ref": "#/$defs/localId" },
              "trigger": {
                "enum": [
                  "workspace-focused", "task-focused", "pane-focused",
                  "pane-opened", "pane-closed", "pane-moved", "layout-changed",
                  "terminal-session-focused", "terminal-session-closed"
                ]
              },
              "clientCommand": { "$ref": "#/$defs/namespacedId" },
              "debounceMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60000
              },
              "ownerApproval": {
                "enum": ["installation", "first-use", "every-invocation"]
              },
              "inputMapping": {
                "type": "object",
                "maxProperties": 16,
                "propertyNames": {
                  "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^\\$(?:event|slice)\\.[a-z][a-zA-Z0-9.]{0,63}$"
                }
              }
            }
          }
        }
      }
    },
    "sourcePromotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sourceType", "prepareCommand", "createCommand", "linkCommand"],
      "properties": {
        "kind": { "const": "source-promotion" },
        "sourceType": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,99}$" },
        "prepareCommand": { "$ref": "#/$defs/namespacedId" },
        "createCommand": { "$ref": "#/$defs/namespacedId" },
        "linkCommand": { "oneOf": [{ "$ref": "#/$defs/namespacedId" }, { "type": "null" }] }
      }
    },
    "rendererProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "renderer", "implementation", "minimumClientVersion", "desktopBehavior", "features", "accessibilityContract", "mobileFallback"],
      "properties": {
        "kind": { "const": "renderer-provider" },
        "renderer": { "$ref": "#/$defs/rendererId" },
        "implementation": { "type": "string", "pattern": "^acorn\\.client\\.[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 160 },
        "minimumClientVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "desktopBehavior": { "enum": ["embedded", "native-view", "stream-host"] },
        "features": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" } },
        "accessibilityContract": { "$ref": "#/$defs/schemaRef" },
        "mobileFallback": { "enum": ["semantic", "read-only", "unsupported"] }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tokensPath"],
      "properties": {
        "kind": { "enum": ["theme", "style"] },
        "tokensPath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$", "maxLength": 240 }
      }
    }
  }
}
