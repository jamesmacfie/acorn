{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acorn.dev/schemas/v2/plugin-lock-v2.schema.json",
  "title": "Acorn V2 resolved plugin lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "nodeId", "generation", "resolvedAt", "plugins", "signature"],
  "properties": {
    "apiVersion": { "const": "acorn.dev/plugin-lock/v2" },
    "nodeId": { "$ref": "#/$defs/uuidv7" },
    "generation": { "$ref": "#/$defs/decimal" },
    "resolvedAt": { "$ref": "#/$defs/timestamp" },
    "plugins": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "coordinate", "version", "manifestDigest", "trustTier", "source", "artifacts",
          "dependencies", "grants", "storageSchemaVersion"
        ],
        "properties": {
          "coordinate": { "$ref": "#/$defs/coordinate" },
          "version": { "$ref": "#/$defs/semver" },
          "manifestDigest": { "$ref": "#/$defs/digest" },
          "trustTier": { "enum": ["system", "acorn-verified", "community", "developer-source"] },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "locator", "immutableRef"],
            "properties": {
              "kind": { "enum": ["acorn-marketplace", "community-marketplace", "git"] },
              "locator": { "type": "string", "minLength": 1, "maxLength": 500 },
              "immutableRef": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "digest", "platform", "architecture"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
                "digest": { "$ref": "#/$defs/digest" },
                "platform": { "enum": ["any", "darwin", "linux", "windows"] },
                "architecture": { "enum": ["any", "arm64", "x86_64"] }
              }
            }
          },
          "dependencies": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["coordinate", "version", "manifestDigest"],
              "properties": {
                "coordinate": { "$ref": "#/$defs/coordinate" },
                "version": { "$ref": "#/$defs/semver" },
                "manifestDigest": { "$ref": "#/$defs/digest" }
              }
            }
          },
          "grants": {
            "type": "array",
            "maxItems": 128,
            "items": { "$ref": "capability-v2.schema.json#/$defs/securityGrant" }
          },
          "storageSchemaVersion": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "minLength": 8, "maxLength": 200 },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    }
  },
  "$defs": {
    "uuidv7": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "coordinate": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}/[a-z][a-z0-9-]{1,62}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  }
}
