{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acorn.dev/schemas/v2/setup-wizard-v2.schema.json",
  "title": "Acorn V2 setup wizard definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "plugin", "id", "version", "purpose", "scope", "title", "resumable",
    "entry", "activationGate", "resumePolicy", "cancelPolicy", "completion", "steps"
  ],
  "properties": {
    "apiVersion": { "const": "acorn.dev/setup-wizard/v2" },
    "plugin": { "$ref": "#/$defs/coordinate" },
    "id": { "$ref": "#/$defs/localId" },
    "version": { "type": "integer", "minimum": 1 },
    "purpose": { "enum": ["install", "connect", "repair", "migrate", "reauthorize", "uninstall"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "resourceTypes"],
      "properties": {
        "base": { "enum": ["installation", "workspace", "resource"] },
        "resourceTypes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,99}$" }
        }
      }
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "resumable": { "type": "boolean" },
    "entry": { "$ref": "#/$defs/localId" },
    "activationGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "capabilities"],
      "properties": {
        "mode": { "enum": ["none", "required", "required-capabilities"] },
        "capabilities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namespacedId" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "required-capabilities" } } },
          "then": { "properties": { "capabilities": { "type": "array", "minItems": 1 } } },
          "else": { "properties": { "capabilities": { "type": "array", "maxItems": 0 } } }
        }
      ]
    },
    "resumePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibleVersions", "onIncompatible"],
      "properties": {
        "compatibleVersions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "onIncompatible": { "enum": ["restart", "repair"] }
      }
    },
    "cancelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "cleanupCommand"],
      "properties": {
        "mode": { "enum": ["retain-effects", "cleanup-effects"] },
        "cleanupCommand": {
          "oneOf": [
            { "$ref": "#/$defs/namespacedId" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "cleanup-effects" } } },
          "then": { "properties": { "cleanupCommand": { "$ref": "#/$defs/namespacedId" } } },
          "else": { "properties": { "cleanupCommand": { "type": "null" } } }
        }
      ]
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postconditions", "nextAction"],
      "properties": {
        "postconditions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namespacedId" }
        },
        "nextAction": { "enum": ["none", "settings", "workspace", "task", "plugin-detail"] }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "coordinate": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}/[a-z][a-z0-9-]{1,62}$"
    },
    "localId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "namespacedId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:[.-][a-z0-9-]+)+(?:\\.v[1-9][0-9]*)?$",
      "maxLength": 200
    },
    "schemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest"],
      "properties": {
        "uri": { "type": "string", "format": "uri", "maxLength": 500 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator"],
      "properties": {
        "operator": { "enum": ["always", "equals", "not-equals", "present", "truthy"] },
        "source": { "enum": ["answer", "state", "validation"] },
        "path": { "type": "string", "pattern": "^(?:|/(?:[^~/]|~0|~1)*)$", "maxLength": 300 },
        "value": {
          "anyOf": [
            { "type": "string", "maxLength": 500 },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "condition"],
      "properties": {
        "step": { "$ref": "#/$defs/localId" },
        "condition": { "$ref": "#/$defs/condition" }
      }
    },
    "informationConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "links"],
      "properties": {
        "body": { "type": "string", "maxLength": 10000 },
        "links": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 120 },
              "url": { "type": "string", "format": "uri", "pattern": "^https://" }
            }
          }
        }
      }
    },
    "permissionsConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities"],
      "properties": {
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namespacedId" }
        }
      }
    },
    "secretConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setting", "purpose"],
      "properties": {
        "setting": { "$ref": "#/$defs/localId" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "oauthConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectionType", "startCommand"],
      "properties": {
        "connectionType": { "$ref": "#/$defs/namespacedId" },
        "startCommand": { "$ref": "#/$defs/namespacedId" }
      }
    },
    "resourceSelectionConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "resourceTypes", "minSelections", "maxSelections"],
      "properties": {
        "query": { "$ref": "#/$defs/namespacedId" },
        "resourceTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,99}$" }
        },
        "minSelections": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "maxSelections": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "formConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": { "schema": { "$ref": "#/$defs/schemaRef" } }
    },
    "validationConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": { "command": { "$ref": "#/$defs/namespacedId" } }
    },
    "asyncConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "cancellable"],
      "properties": {
        "command": { "$ref": "#/$defs/namespacedId" },
        "cancellable": { "type": "boolean" }
      }
    },
    "confirmationConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "summaryBindings"],
      "properties": {
        "risk": {
          "enum": [
            "permissions", "credential", "native-execution", "destructive",
            "network-egress", "data-sharing"
          ]
        },
        "summaryBindings": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?:|/(?:[^~/]|~0|~1)*)$", "maxLength": 300 }
        }
      }
    },
    "completionConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "nextAction"],
      "properties": {
        "result": { "enum": ["success", "partial", "failure"] },
        "nextAction": { "enum": ["none", "settings", "workspace", "task", "plugin-detail"] }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "optional", "configuration", "next"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "type": {
          "enum": [
            "information", "permissions", "secret", "oauth-device", "resource-selection",
            "form", "validation", "async-operation", "confirmation", "completion"
          ]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 1000 },
        "optional": { "type": "boolean" },
        "configuration": {
          "oneOf": [
            { "$ref": "#/$defs/informationConfiguration" },
            { "$ref": "#/$defs/permissionsConfiguration" },
            { "$ref": "#/$defs/secretConfiguration" },
            { "$ref": "#/$defs/oauthConfiguration" },
            { "$ref": "#/$defs/resourceSelectionConfiguration" },
            { "$ref": "#/$defs/formConfiguration" },
            { "$ref": "#/$defs/validationConfiguration" },
            { "$ref": "#/$defs/asyncConfiguration" },
            { "$ref": "#/$defs/confirmationConfiguration" },
            { "$ref": "#/$defs/completionConfiguration" }
          ]
        },
        "next": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/transition" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "information" } } },
          "then": { "properties": { "configuration": { "$ref": "#/$defs/informationConfiguration" } } }
        },
        {
          "if": { "properties": { "type": { "const": "permissions" } } },
          "then": { "properties": { "configuration": { "$ref": "#/$defs/permissionsConfiguration" } } }
        },
        {
          "if": { "properties": { "type": { "const": "secret" } } },
          "then": { "properties": { "configuration": { "$ref": "#/$defs/secretConfiguration" } } }
        },
        {
          "if": { "properties": { "type": { "const": "oauth-device" } } },
          "then": { "properties": { "configuration": { "$ref": "#/$defs/oauthConfiguration" } } }
        },
        {
          "if": { "properties": { "type": { "const": "resource-selection" } } },
          "then": { "properties": { "configuration": { "$ref": "#/$defs/resourceSelectionConfiguration" } } }
        },
        {
          "if": { "properties": { "type": { "const": "form" } } },
          "then": { "properties": { "configuration": { "$ref": "#/$defs/formConfiguration" } } }
        },
        {
          "if": { "properties": { "type": { "const": "validation" } } },
          "then": { "properties": { "configuration": { "$ref": "#/$defs/validationConfiguration" } } }
        },
        {
          "if": { "properties": { "type": { "const": "async-operation" } } },
          "then": { "properties": { "configuration": { "$ref": "#/$defs/asyncConfiguration" } } }
        },
        {
          "if": { "properties": { "type": { "const": "confirmation" } } },
          "then": { "properties": { "configuration": { "$ref": "#/$defs/confirmationConfiguration" } } }
        },
        {
          "if": { "properties": { "type": { "const": "completion" } } },
          "then": {
            "properties": {
              "configuration": { "$ref": "#/$defs/completionConfiguration" },
              "next": { "type": "array", "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
