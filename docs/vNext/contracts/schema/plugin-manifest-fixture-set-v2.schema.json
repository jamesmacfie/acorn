{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acorn.dev/schemas/v2/plugin-manifest-fixture-set-v2.schema.json",
  "title": "Acorn V2 manifest fixture set",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "purpose", "manifests"],
  "properties": {
    "apiVersion": { "const": "acorn.dev/plugin-manifest-fixtures/v2" },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
    "manifests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "plugin-manifest-v2.schema.json" }
    }
  }
}
