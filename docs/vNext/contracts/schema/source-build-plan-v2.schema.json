{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acorn.dev/schemas/v2/source-build-plan-v2.schema.json",
  "title": "Acorn V2 Developer Source build plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "planId", "source", "builder", "dependencies", "steps",
    "outputs", "reproducibility"
  ],
  "properties": {
    "apiVersion": { "const": "acorn.dev/source-build-plan/v2" },
    "planId": { "$ref": "#/$defs/uuidv7" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "treeDigest", "submodules"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s?#]+(?:\\.git)?$",
          "maxLength": 500
        },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "treeDigest": { "$ref": "#/$defs/digest" },
        "submodules": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "repository", "commit", "treeDigest"],
            "properties": {
              "path": { "$ref": "#/$defs/relativePath" },
              "repository": { "type": "string", "format": "uri", "pattern": "^https://[^\\s?#]+(?:\\.git)?$", "maxLength": 500 },
              "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "treeDigest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageDigest", "platform", "architecture", "tools", "resources"],
      "properties": {
        "imageDigest": { "$ref": "#/$defs/digest" },
        "platform": { "enum": ["linux"] },
        "architecture": { "enum": ["arm64", "x86_64"] },
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "digest"],
            "properties": {
              "id": { "$ref": "#/$defs/localId" },
              "path": { "type": "string", "pattern": "^/acorn-tools/[a-zA-Z0-9._/-]+$", "maxLength": 240 },
              "digest": { "$ref": "#/$defs/digest" }
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpuMillis", "memoryMiB", "diskMiB", "wallTimeMs", "processes", "outputBytes"],
          "properties": {
            "cpuMillis": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
            "memoryMiB": { "type": "integer", "minimum": 64, "maximum": 8192 },
            "diskMiB": { "type": "integer", "minimum": 128, "maximum": 32768 },
            "wallTimeMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
            "processes": { "type": "integer", "minimum": 1, "maximum": 256 },
            "outputBytes": { "type": "integer", "minimum": 1, "maximum": 2147483648 }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "locator", "digest", "size"],
        "properties": {
          "id": { "$ref": "#/$defs/localId" },
          "kind": { "enum": ["archive", "module-cache", "toolchain-input"] },
          "locator": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 500 },
          "digest": { "$ref": "#/$defs/digest" },
          "size": { "type": "integer", "minimum": 1, "maximum": 2147483648 }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tool", "arguments", "workingDirectory", "environment", "inputs", "outputs", "timeoutMs"],
        "properties": {
          "id": { "$ref": "#/$defs/localId" },
          "tool": { "$ref": "#/$defs/localId" },
          "arguments": {
            "type": "array",
            "maxItems": 128,
            "items": { "type": "string", "maxLength": 500 }
          },
          "workingDirectory": { "$ref": "#/$defs/relativePath" },
          "environment": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
            "additionalProperties": { "type": "string", "maxLength": 500 }
          },
          "inputs": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/relativePath" } },
          "outputs": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/relativePath" } },
          "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 600000 }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "path", "kind", "runtime", "maximumBytes"],
        "properties": {
          "artifactId": { "$ref": "#/$defs/localId" },
          "path": { "$ref": "#/$defs/relativePath" },
          "kind": { "enum": ["runtime", "ui", "assets", "schemas", "migrations"] },
          "runtime": { "enum": ["none", "declarative", "wasi-component", "native-process", "bespoke-ui"] },
          "maximumBytes": { "type": "integer", "minimum": 1, "maximum": 2147483648 }
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceDateEpoch", "runCount", "requireIdenticalDigests"],
      "properties": {
        "sourceDateEpoch": { "type": "integer", "minimum": 0, "maximum": 4102444800 },
        "runCount": { "const": 2 },
        "requireIdenticalDigests": { "const": true }
      }
    }
  },
  "$defs": {
    "uuidv7": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "localId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "maxLength": 240
    }
  }
}
