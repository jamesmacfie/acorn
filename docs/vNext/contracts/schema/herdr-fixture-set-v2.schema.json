{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acorn.dev/schemas/v2/herdr-fixture-set-v2.schema.json",
  "title": "Acorn V2 Herdr top-100 materialized compatibility fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "source",
    "normalization",
    "counts",
    "rows"
  ],
  "properties": {
    "apiVersion": { "const": "acorn.dev/herdr-fixtures/v2" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "accessedAt", "snapshotGeneratedAt", "records"],
      "properties": {
        "url": { "const": "https://herdr.dev/plugins/" },
        "accessedAt": { "const": "2026-07-30" },
        "snapshotGeneratedAt": { "type": "string", "format": "date-time" },
        "records": { "const": 416 }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "algorithm", "version", "operationPayloadSemantics"],
      "properties": {
        "publisher": { "const": "community-herdr" },
        "algorithm": { "const": "p-slug6-base32lower-sha256-github-full-name" },
        "version": { "const": 1 },
        "operationPayloadSemantics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "targetCarriesActiveResource",
            "emptyInput",
            "queryResult",
            "clientCommandResult",
            "streamCommandResult",
            "commandResult"
          ],
          "properties": {
            "version": { "const": 2 },
            "targetCarriesActiveResource": { "type": "string", "minLength": 1, "maxLength": 500 },
            "emptyInput": { "type": "string", "minLength": 1, "maxLength": 500 },
            "queryResult": { "type": "string", "minLength": 1, "maxLength": 500 },
            "clientCommandResult": { "type": "string", "minLength": 1, "maxLength": 500 },
            "streamCommandResult": { "type": "string", "minLength": 1, "maxLength": 500 },
            "commandResult": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "supported",
        "extension",
        "unsupported",
        "actions",
        "panes",
        "eventEntries",
        "startupEntries",
        "linkHandlers",
        "buildEntries",
        "workerRepositories"
      ],
      "properties": {
        "rows": { "const": 100 },
        "supported": { "const": 89 },
        "extension": { "const": 7 },
        "unsupported": { "const": 4 },
        "actions": { "const": 294 },
        "panes": { "const": 108 },
        "eventEntries": { "const": 130 },
        "startupEntries": { "const": 7 },
        "linkHandlers": { "const": 10 },
        "buildEntries": { "const": 59 },
        "workerRepositories": { "const": 35 }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "coordinate": {
      "type": "string",
      "pattern": "^community-herdr/p-[a-z0-9-]{1,8}-[a-z2-7]{52}$",
      "maxLength": 127
    },
    "stringArray": {
      "type": "array",
      "maxItems": 256,
      "items": { "type": "string", "maxLength": 1000 }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "repository",
        "repositoryUrl",
        "commit",
        "treeUrl",
        "observedVersions",
        "manifestPaths"
      ],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 100 },
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$",
          "maxLength": 240
        },
        "repositoryUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/"
        },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "treeUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/"
        },
        "observedVersions": { "$ref": "#/$defs/stringArray" },
        "manifestPaths": { "$ref": "#/$defs/stringArray" }
      }
    },
    "evidenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestPath",
        "ordinal",
        "id",
        "title",
        "contexts",
        "command",
        "platforms",
        "placement",
        "event",
        "pattern",
        "action"
      ],
      "properties": {
        "manifestPath": { "type": "string", "maxLength": 500 },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "id": { "type": ["string", "null"], "maxLength": 500 },
        "title": { "type": ["string", "null"], "maxLength": 500 },
        "contexts": { "$ref": "#/$defs/stringArray" },
        "command": { "$ref": "#/$defs/stringArray" },
        "platforms": { "$ref": "#/$defs/stringArray" },
        "placement": { "type": ["string", "null"], "maxLength": 100 },
        "event": { "type": ["string", "null"], "maxLength": 200 },
        "pattern": { "type": ["string", "null"], "maxLength": 2000 },
        "action": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions",
        "panes",
        "events",
        "startup",
        "links",
        "builds",
        "keybindings",
        "themes",
        "workerEvidence"
      ],
      "properties": {
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceEntry" }
        },
        "panes": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceEntry" }
        },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceEntry" }
        },
        "startup": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceEntry" }
        },
        "links": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceEntry" }
        },
        "builds": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceEntry" }
        },
        "keybindings": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "key", "command", "disposition"],
            "properties": {
              "source": { "enum": ["keys.command", "keybindings"] },
              "key": { "type": "string", "minLength": 1, "maxLength": 100 },
              "command": { "type": "string", "minLength": 1, "maxLength": 500 },
              "disposition": {
                "enum": ["host-command", "renderer-semantic"]
              }
            }
          }
        },
        "themes": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "disposition"],
            "properties": {
              "source": { "type": "string", "minLength": 1, "maxLength": 100 },
              "disposition": { "const": "respect-client-semantic-theme" }
            }
          }
        },
        "workerEvidence": {
          "type": ["string", "null"],
          "maxLength": 500
        }
      }
    },
    "eventDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceEvent",
        "manifestPath",
        "ordinal",
        "class",
        "acornEvent",
        "ordering",
        "persistence",
        "privacy",
        "snapshotQuery"
      ],
      "properties": {
        "sourceEvent": { "type": "string", "minLength": 1, "maxLength": 200 },
        "manifestPath": { "type": "string", "minLength": 1, "maxLength": 500 },
        "ordinal": { "type": "integer", "minimum": 1 },
        "class": { "enum": ["node-fact", "client-presentation", "renderer-local"] },
        "acornEvent": { "type": "string", "minLength": 1, "maxLength": 240 },
        "ordering": {
          "enum": ["node-sequence-at-least-once", "client-epoch-sequence", "view-session-sequence"]
        },
        "persistence": {
          "enum": ["durable-cursor", "client-device-bounded", "view-session-only"]
        },
        "privacy": {
          "enum": ["node-authorized", "client-local-only", "guest-local"]
        },
        "snapshotQuery": { "type": ["string", "null"], "maxLength": 240 }
      }
    },
    "operationSchemaField": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "minLength", "maxLength"],
          "properties": {
            "type": { "const": "string" },
            "format": { "enum": ["uri", "date-time"] },
            "pattern": { "type": "string", "minLength": 1, "maxLength": 500 },
            "const": { "type": "string", "minLength": 1, "maxLength": 100 },
            "minLength": { "type": "integer", "minimum": 0, "maximum": 2048 },
            "maxLength": { "type": "integer", "minimum": 1, "maximum": 2048 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "minimum", "maximum"],
          "properties": {
            "type": { "const": "integer" },
            "minimum": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        }
      ]
    },
    "operationSchemaDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "$id",
        "title",
        "type",
        "additionalProperties",
        "required",
        "properties"
      ],
      "properties": {
        "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
        "$id": { "type": "string", "format": "uri", "maxLength": 500 },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "type": { "const": "object" },
        "additionalProperties": { "const": false },
        "required": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
          }
        },
        "properties": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
          },
          "additionalProperties": { "$ref": "#/$defs/operationSchemaField" }
        }
      }
    },
    "operationSchemaEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest", "operationId", "role", "document"],
      "properties": {
        "uri": { "type": "string", "format": "uri", "maxLength": 500 },
        "digest": { "$ref": "#/$defs/digest" },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "role": { "enum": ["input", "result"] },
        "document": { "$ref": "#/$defs/operationSchemaDocument" }
      }
    },
    "customEventContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "producerOperation",
        "sensitivity",
        "redaction",
        "schema",
        "document"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^community-herdr\\.[a-z][a-z0-9-]+(?:\\.[a-z][a-z0-9-]+)+\\.v[1-9][0-9]*$",
          "maxLength": 220
        },
        "version": { "const": 1 },
        "producerOperation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "sensitivity": { "const": "internal" },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eventFields", "auditFields", "logFields"],
          "properties": {
            "eventFields": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
              }
            },
            "auditFields": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
              }
            },
            "logFields": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri", "digest"],
          "properties": {
            "uri": { "type": "string", "format": "uri", "maxLength": 500 },
            "digest": { "$ref": "#/$defs/digest" }
          }
        },
        "document": { "$ref": "#/$defs/operationSchemaDocument" }
      }
    },
    "storagePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "quotaBytes",
        "classes",
        "backup",
        "migrationPolicy",
        "uninstall",
        "reinstall"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 0 },
        "quotaBytes": { "type": "integer", "minimum": 0, "maximum": 10737418240 },
        "classes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["sqlite", "blob", "cache", "index"] }
        },
        "backup": { "enum": ["include", "exclude-cache", "exclude-all"] },
        "migrationPolicy": { "const": "host-transactional-signed" },
        "uninstall": { "enum": ["delete", "retain-30-days"] },
        "reinstall": { "enum": ["fresh", "reattach-same-publisher-coordinate"] }
      }
    },
    "buildDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestPath",
        "ordinal",
        "sourceCommit",
        "disposition",
        "sourceTreeDigest",
        "plan",
        "activation"
      ],
      "properties": {
        "manifestPath": { "type": "string", "minLength": 1, "maxLength": 500 },
        "ordinal": { "type": "integer", "minimum": 1 },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "disposition": {
          "enum": [
            "published-artifact",
            "validated-source-plan",
            "developer-author-plan-required",
            "unsupported",
            "extension",
            "not-applicable"
          ]
        },
        "sourceTreeDigest": {
          "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        },
        "plan": {
          "oneOf": [
            { "$ref": "source-build-plan-v2.schema.json" },
            { "type": "null" }
          ]
        },
        "activation": {
          "enum": [
            "ready",
            "awaiting-author-plan",
            "blocked-product-decision",
            "blocked-extension",
            "not-applicable"
          ]
        }
      }
    },
    "rendererPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredCapabilities",
        "desktop",
        "missingCapability",
        "accessibility",
        "mobile"
      ],
      "properties": {
        "requiredCapabilities": { "$ref": "#/$defs/stringArray" },
        "desktop": { "type": "string", "minLength": 1, "maxLength": 500 },
        "missingCapability": { "type": "string", "minLength": 1, "maxLength": 500 },
        "accessibility": { "type": "string", "minLength": 1, "maxLength": 500 },
        "mobile": { "enum": ["semantic", "read-only", "unsupported"] }
      }
    },
    "lifecyclePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install",
        "permission",
        "setup",
        "activation",
        "health",
        "update",
        "rollback",
        "disable",
        "quarantine",
        "uninstall",
        "restartReconciliation"
      ],
      "properties": {
        "install": { "const": "coordinated-resumable-node-client" },
        "permission": { "const": "owner-approved-exact-grants" },
        "setup": { "const": "resumable-node-owned-wizard" },
        "activation": { "const": "health-gated-atomic-generation-switch" },
        "health": { "const": "supervised-threshold-quarantine" },
        "update": { "const": "staged-migration-backup" },
        "rollback": { "const": "previous-compatible-generation" },
        "disable": { "const": "revoke-admission-drain" },
        "quarantine": { "const": "fail-closed-owner-recovery" },
        "uninstall": { "const": "explicit-data-choice" },
        "restartReconciliation": { "const": "persisted-state-machine-reconcile" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "coordinate",
        "coordinateBinding",
        "archetype",
        "fit",
        "decision",
        "observed",
        "manifest",
        "operations",
        "operationSchemas",
        "workers",
        "nodeEvents",
        "clientEvents",
        "rendererEvents",
        "customEvents",
        "streams",
        "storage",
        "builds",
        "renderers",
        "lifecycle",
        "bespokeDisposition",
        "activation"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^HERDR-(?:00[1-9]|0[1-9][0-9]|100)$" },
        "source": { "$ref": "#/$defs/source" },
        "coordinate": { "$ref": "#/$defs/coordinate" },
        "coordinateBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonicalSourceKey", "algorithmVersion"],
          "properties": {
            "canonicalSourceKey": {
              "type": "string",
              "pattern": "^[^/\\s]+/[^/\\s]+$"
            },
            "algorithmVersion": { "const": 1 }
          }
        },
        "archetype": { "type": "string", "pattern": "^ARC-(?:0[1-9]|[12][0-9]|3[0-5])$" },
        "fit": { "enum": ["Supported", "Extension", "Unsupported"] },
        "decision": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "effect"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^HERDR-(?:EXT|DEC)-[0-9]{3}$"
                },
                "effect": {
                  "enum": ["activation-blocked", "not-installable"]
                }
              }
            }
          ]
        },
        "observed": { "$ref": "#/$defs/observed" },
        "manifest": {
          "oneOf": [
            { "$ref": "plugin-manifest-v2.schema.json" },
            { "type": "null" }
          ]
        },
        "operations": {
          "type": "array",
          "items": { "$ref": "plugin-operation-v2.schema.json" }
        },
        "operationSchemas": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/operationSchemaEntry" }
        },
        "workers": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "worker-v2.schema.json" }
        },
        "nodeEvents": {
          "type": "array",
          "items": { "$ref": "#/$defs/eventDisposition" }
        },
        "clientEvents": {
          "type": "array",
          "items": { "$ref": "#/$defs/eventDisposition" }
        },
        "rendererEvents": {
          "type": "array",
          "items": { "$ref": "#/$defs/eventDisposition" }
        },
        "customEvents": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/customEventContract" }
        },
        "streams": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "stream-profile-v2.schema.json" }
        },
        "storage": { "$ref": "#/$defs/storagePlan" },
        "builds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/buildDisposition" }
        },
        "renderers": { "$ref": "#/$defs/rendererPlan" },
        "lifecycle": { "$ref": "#/$defs/lifecyclePlan" },
        "bespokeDisposition": {
          "enum": [
            "not-used",
            "optional-enhancement-semantic-complete",
            "required-schema-valid"
          ]
        },
        "activation": {
          "enum": [
            "ready-after-port-and-artifacts",
            "awaiting-author-plan",
            "blocked-extension",
            "not-installable-product-decision"
          ]
        }
      }
    }
  }
}
