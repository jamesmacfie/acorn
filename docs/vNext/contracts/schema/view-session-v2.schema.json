{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acorn.dev/schemas/v2/view-session-v2.schema.json",
  "title": "Acorn V2 view session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "sessionId", "uri", "nodeId", "contribution", "state", "sessionRevision",
    "documentRevision", "documentDigest", "capability", "idleExpiresAt", "absoluteExpiresAt",
    "grants", "limits"
  ],
  "properties": {
    "apiVersion": { "const": "acorn.dev/view-session/v2" },
    "sessionId": { "$ref": "#/$defs/uuidv7" },
    "uri": { "$ref": "#/$defs/acornUri" },
    "nodeId": { "$ref": "#/$defs/uuidv7" },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin", "id", "version"],
      "properties": {
        "plugin": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}/[a-z][a-z0-9-]{1,62}$" },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      }
    },
    "state": { "enum": ["active", "suspended", "expired", "closed"] },
    "sessionRevision": { "$ref": "#/$defs/decimal" },
    "documentRevision": { "$ref": "#/$defs/decimal" },
    "documentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "capability": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "readOnly": true,
      "description": "Sensitive one-time-issued view capability; never log, cache, persist on the Client, or expose to guest content."
    },
    "idleExpiresAt": { "$ref": "#/$defs/timestamp" },
    "absoluteExpiresAt": { "$ref": "#/$defs/timestamp" },
    "grants": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "expiresAt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?:/[1-9][0-9]*)$" },
          "scope": { "$ref": "#/$defs/acornUri" },
          "expiresAt": { "$ref": "#/$defs/timestamp" }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxDocumentBytes", "maxNodes", "maxDepth", "maxPatchOperations",
        "maxActionsPerMinute", "maxControlMessageBytes", "maxMessagesPerSecond",
        "maxBytesPerSecond", "maxInflightRequests", "maxLiveDataBytes",
        "maxIdleSeconds", "maxAbsoluteSeconds"
      ],
      "properties": {
        "maxDocumentBytes": { "type": "integer", "minimum": 1024, "maximum": 917504 },
        "maxNodes": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "maxDepth": { "type": "integer", "minimum": 1, "maximum": 32 },
        "maxPatchOperations": { "type": "integer", "minimum": 1, "maximum": 256 },
        "maxActionsPerMinute": { "type": "integer", "minimum": 1, "maximum": 600 },
        "maxControlMessageBytes": { "type": "integer", "minimum": 1024, "maximum": 262144 },
        "maxMessagesPerSecond": { "type": "integer", "minimum": 1, "maximum": 60 },
        "maxBytesPerSecond": { "type": "integer", "minimum": 1024, "maximum": 2097152 },
        "maxInflightRequests": { "type": "integer", "minimum": 1, "maximum": 16 },
        "maxLiveDataBytes": { "type": "integer", "minimum": 1048576, "maximum": 33554432 },
        "maxIdleSeconds": { "type": "integer", "minimum": 60, "maximum": 900 },
        "maxAbsoluteSeconds": { "type": "integer", "minimum": 300, "maximum": 28800 }
      }
    }
  },
  "$defs": {
    "uuidv7": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "acornUri": { "type": "string", "pattern": "^acorn://[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/[a-z][a-z0-9.-]*/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  }
}
