{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acorn.dev/schemas/v2/worker-v2.schema.json",
  "title": "Acorn V2 supervised worker",
  "oneOf": [
    { "$ref": "#/$defs/scheduled" },
    { "$ref": "#/$defs/eventDriven" },
    { "$ref": "#/$defs/resident" }
  ],
  "$defs": {
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:[.-][a-z0-9-]+)+\\.v[1-9][0-9]*$",
      "maxLength": 200
    },
    "localId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "backoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialMs", "maximumMs", "multiplier", "jitterPercent", "maxConsecutiveFailures"],
      "properties": {
        "initialMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "maximumMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "multiplier": { "type": "number", "minimum": 1, "maximum": 10 },
        "jitterPercent": { "type": "integer", "minimum": 0, "maximum": 50 },
        "maxConsecutiveFailures": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "maximumBytes", "schema"],
      "properties": {
        "enabled": { "type": "boolean" },
        "maximumBytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "schema": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["uri", "digest"],
              "properties": {
                "uri": { "type": "string", "format": "uri", "maxLength": 500 },
                "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoryMiB", "cpuMillisPerMinute", "handles", "outputBytesPerMinute"],
      "properties": {
        "memoryMiB": { "type": "integer", "minimum": 16, "maximum": 2048 },
        "cpuMillisPerMinute": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "handles": { "type": "integer", "minimum": 8, "maximum": 1024 },
        "outputBytesPerMinute": { "type": "integer", "minimum": 1024, "maximum": 67108864 }
      }
    },
    "scheduled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion", "id", "mode", "operation", "minimumIntervalMs", "jitterMs",
        "timeoutMs", "overlap", "visibility", "missedTick", "startup", "backoff",
        "checkpoint", "resources"
      ],
      "properties": {
        "apiVersion": { "const": "acorn.dev/worker/v2" },
        "id": { "$ref": "#/$defs/localId" },
        "mode": { "const": "scheduled" },
        "operation": { "$ref": "#/$defs/operation" },
        "minimumIntervalMs": { "type": "integer", "minimum": 5000, "maximum": 86400000 },
        "jitterMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000 },
        "overlap": { "enum": ["skip", "coalesce", "queue-one"] },
        "visibility": { "enum": ["always", "connected-client", "visible-contribution"] },
        "missedTick": { "enum": ["skip", "run-once"] },
        "startup": { "enum": ["wait-first-interval", "run-immediately"] },
        "backoff": { "$ref": "#/$defs/backoff" },
        "checkpoint": { "$ref": "#/$defs/checkpoint" },
        "resources": { "$ref": "#/$defs/resources" }
      }
    },
    "eventDriven": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion", "id", "mode", "operation", "events", "batchSize",
        "batchWindowMs", "timeoutMs", "overlap", "gapRecovery", "backoff",
        "checkpoint", "resources"
      ],
      "properties": {
        "apiVersion": { "const": "acorn.dev/worker/v2" },
        "id": { "$ref": "#/$defs/localId" },
        "mode": { "const": "event-driven" },
        "operation": { "$ref": "#/$defs/operation" },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/operation" }
        },
        "batchSize": { "type": "integer", "minimum": 1, "maximum": 500 },
        "batchWindowMs": { "type": "integer", "minimum": 0, "maximum": 30000 },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000 },
        "overlap": { "enum": ["serial", "partitioned"] },
        "gapRecovery": { "enum": ["snapshot", "restart-worker", "disable"] },
        "backoff": { "$ref": "#/$defs/backoff" },
        "checkpoint": { "$ref": "#/$defs/checkpoint" },
        "resources": { "$ref": "#/$defs/resources" }
      }
    },
    "resident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion", "id", "mode", "operation", "startup", "readinessTimeoutMs",
        "heartbeatIntervalMs", "heartbeatTimeoutMs", "drainTimeoutMs", "restart",
        "backoff", "checkpoint", "resources"
      ],
      "properties": {
        "apiVersion": { "const": "acorn.dev/worker/v2" },
        "id": { "$ref": "#/$defs/localId" },
        "mode": { "const": "resident" },
        "operation": { "$ref": "#/$defs/operation" },
        "startup": { "enum": ["node-ready", "installation-active", "first-demand"] },
        "readinessTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000 },
        "heartbeatIntervalMs": { "type": "integer", "minimum": 1000, "maximum": 60000 },
        "heartbeatTimeoutMs": { "type": "integer", "minimum": 2000, "maximum": 180000 },
        "drainTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000 },
        "restart": { "enum": ["never", "on-failure", "always"] },
        "backoff": { "$ref": "#/$defs/backoff" },
        "checkpoint": { "$ref": "#/$defs/checkpoint" },
        "resources": { "$ref": "#/$defs/resources" }
      }
    }
  }
}
