{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acorn.dev/schemas/v2/plugin-manifest-v2.schema.json",
  "title": "Acorn V2 plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "coordinate", "version", "displayName", "description", "compatibility",
    "artifacts", "contributions", "bespokeViews", "operations", "streams", "capabilities", "dependencies", "events", "settings",
    "wizards", "storage", "health", "provenance"
  ],
  "properties": {
    "apiVersion": { "const": "acorn.dev/plugin/v2" },
    "coordinate": { "$ref": "#/$defs/coordinate" },
    "version": { "$ref": "#/$defs/semver" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "license": { "type": "string", "minLength": 1, "maxLength": 80 },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeProtocol", "clientProtocol", "rendererCapabilities"],
      "properties": {
        "nodeProtocol": { "$ref": "#/$defs/protocolRange" },
        "clientProtocol": { "$ref": "#/$defs/protocolRange" },
        "rendererCapabilities": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "capability-v2.schema.json#/$defs/rendererAdvertisement" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "target", "runtime", "digest", "size", "mediaType", "path", "platform", "architecture"],
        "properties": {
          "id": { "$ref": "#/$defs/localId" },
          "kind": { "enum": ["runtime", "ui", "assets", "schemas", "migrations"] },
          "target": { "enum": ["node", "client", "shared"] },
          "runtime": { "enum": ["none", "declarative", "wasi-component", "native-process", "system", "bespoke-ui"] },
          "digest": { "$ref": "#/$defs/digest" },
          "size": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
          "mediaType": { "type": "string", "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$", "maxLength": 160 },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
            "maxLength": 240
          },
          "platform": { "enum": ["any", "darwin", "linux", "windows"] },
          "architecture": { "enum": ["any", "arm64", "x86_64"] },
          "entrypoint": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
            "maxLength": 240
          }
        },
        "allOf": [
          {
            "if": { "properties": { "runtime": { "const": "bespoke-ui" } } },
            "then": { "properties": { "target": { "const": "client" } } }
          },
          {
            "if": { "properties": { "runtime": { "enum": ["wasi-component", "native-process", "system"] } } },
            "then": { "properties": { "target": { "const": "node" } } }
          }
        ]
      }
    },
    "contributions": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "contribution-v2.schema.json" }
    },
    "bespokeViews": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "bespoke-view-v2.schema.json" }
    },
    "operations": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "descriptor"],
        "properties": {
          "id": { "$ref": "#/$defs/namespacedId" },
          "descriptor": { "$ref": "#/$defs/schemaRef" }
        }
      }
    },
    "streams": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "stream-profile-v2.schema.json" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "exported"],
      "properties": {
        "requested": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "capability-v2.schema.json#/$defs/permissionRequest" }
        },
        "exported": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "inputSchema", "outputSchema"],
            "properties": {
              "id": { "$ref": "#/$defs/namespacedId" },
              "version": { "$ref": "#/$defs/semver" },
              "inputSchema": { "$ref": "#/$defs/schemaRef" },
              "outputSchema": { "$ref": "#/$defs/schemaRef" }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["coordinate", "version", "optional", "capabilities", "events"],
        "properties": {
          "coordinate": { "$ref": "#/$defs/coordinate" },
          "version": { "$ref": "#/$defs/semverRange" },
          "optional": { "type": "boolean" },
          "capabilities": {
            "type": "array",
            "maxItems": 64,
            "items": { "$ref": "#/$defs/namespacedId" }
          },
          "events": {
            "type": "array",
            "maxItems": 64,
            "items": { "$ref": "#/$defs/namespacedId" }
          }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publishes", "subscribes"],
      "properties": {
        "publishes": { "$ref": "#/$defs/events" },
        "subscribes": { "$ref": "#/$defs/events" }
      }
    },
    "settings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "schema", "scopes", "containsSecrets"],
        "properties": {
          "id": { "$ref": "#/$defs/localId" },
          "schema": { "$ref": "#/$defs/schemaRef" },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["fleet-owner", "node", "workspace", "repository", "task", "installation", "client-device"] }
          },
          "containsSecrets": { "type": "boolean" }
        }
      }
    },
    "wizards": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "schema"],
        "properties": {
          "id": { "$ref": "#/$defs/localId" },
          "schema": { "$ref": "#/$defs/schemaRef" }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "quotaBytes", "backup", "migrations"],
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 0 },
        "quotaBytes": { "type": "integer", "minimum": 0, "maximum": 10737418240 },
        "backup": { "enum": ["include", "exclude-cache", "exclude-all"] },
        "migrations": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "digest", "reversible"],
            "properties": {
              "from": { "type": "integer", "minimum": 0 },
              "to": { "type": "integer", "minimum": 1 },
              "digest": { "$ref": "#/$defs/digest" },
              "reversible": { "type": "boolean" }
            }
          }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startupTimeoutMs", "checkIntervalMs", "failureThreshold"],
      "properties": {
        "startupTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000 },
        "checkIntervalMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "failureThreshold": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisherKeyId", "manifestDigest", "signature", "sbomDigest", "transparencyEntry"],
      "properties": {
        "publisherKeyId": { "type": "string", "minLength": 8, "maxLength": 200 },
        "manifestDigest": { "$ref": "#/$defs/digest" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{40,4096}$" },
        "sbomDigest": { "$ref": "#/$defs/digest" },
        "transparencyEntry": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    }
  },
  "$defs": {
    "coordinate": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}/[a-z][a-z0-9-]{1,62}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "semverRange": { "type": "string", "minLength": 1, "maxLength": 100 },
    "protocolRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$" },
        "max": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$" }
      }
    },
    "localId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "namespacedId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:[.-][a-z0-9-]+)+(?:\\.v[1-9][0-9]*)?$", "maxLength": 200 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "schemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest"],
      "properties": {
        "uri": { "type": "string", "format": "uri", "maxLength": 500 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "version", "schema"],
        "properties": {
          "type": { "$ref": "#/$defs/namespacedId" },
          "version": { "$ref": "#/$defs/semverRange" },
          "schema": { "$ref": "#/$defs/schemaRef" }
        }
      }
    },
    "contributionDefinition": {
      "oneOf": [
        { "$ref": "#/$defs/viewContribution" },
        { "$ref": "#/$defs/routeContribution" },
        { "$ref": "#/$defs/commandContribution" },
        { "$ref": "#/$defs/keybindingContribution" },
        { "$ref": "#/$defs/contextMenuContribution" },
        { "$ref": "#/$defs/eventUiContribution" },
        { "$ref": "#/$defs/workerContribution" },
        { "$ref": "#/$defs/operationContribution" },
        { "$ref": "#/$defs/sourcePromotionContribution" },
        { "$ref": "#/$defs/rendererProviderContribution" },
        { "$ref": "#/$defs/themeContribution" },
        { "$ref": "#/$defs/wizardContribution" }
      ]
    },
    "viewContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "renderer", "title", "order", "mobileFallback"],
      "properties": {
        "kind": {
          "enum": [
            "fleet-source", "workspace-source", "task-pane", "shell-slot", "task-slot",
            "settings-page", "context-section", "agent-tool-renderer"
          ]
        },
        "renderer": { "$ref": "#/$defs/rendererId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "query": { "$ref": "#/$defs/namespacedId" },
        "action": { "$ref": "#/$defs/namespacedId" },
        "slot": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,99}$" },
        "order": { "type": "integer", "minimum": -10000, "maximum": 10000 },
        "mobileFallback": { "enum": ["renderer", "unsupported"] }
      }
    },
    "routeContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "renderer", "mobileFallback"],
      "properties": {
        "kind": { "const": "route" },
        "path": { "type": "string", "pattern": "^/[a-z][a-z0-9-/]*$", "maxLength": 200 },
        "renderer": { "$ref": "#/$defs/rendererId" },
        "mobileFallback": { "enum": ["renderer", "unsupported"] }
      }
    },
    "commandContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "title", "confirmation"],
      "properties": {
        "kind": { "enum": ["command", "navigation-intent"] },
        "command": { "$ref": "#/$defs/namespacedId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "confirmation": { "enum": ["none", "destructive", "credential", "native-execution"] }
      }
    },
    "keybindingContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "shortcut", "when"],
      "properties": {
        "kind": { "const": "keybinding" },
        "command": { "$ref": "#/$defs/namespacedId" },
        "shortcut": { "type": "string", "minLength": 1, "maxLength": 80 },
        "when": { "type": "string", "maxLength": 300 }
      }
    },
    "contextMenuContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "title", "context", "order"],
      "properties": {
        "kind": { "const": "context-menu" },
        "command": { "$ref": "#/$defs/namespacedId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "context": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,99}$" },
        "order": { "type": "integer", "minimum": -10000, "maximum": 10000 }
      }
    },
    "eventUiContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "event", "renderer", "severity"],
      "properties": {
        "kind": { "enum": ["notification", "attention-item", "badge", "notice-kind"] },
        "event": { "$ref": "#/$defs/namespacedId" },
        "renderer": { "$ref": "#/$defs/rendererId" },
        "severity": { "enum": ["info", "success", "warning", "error", "critical"] }
      }
    },
    "workerContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operation", "schedule", "events"],
      "properties": {
        "kind": { "enum": ["poller", "subscription", "background-worker"] },
        "operation": { "$ref": "#/$defs/namespacedId" },
        "schedule": {
          "oneOf": [
            { "type": "string", "pattern": "^PT[1-9][0-9]*[SMH]$" },
            { "type": "null" }
          ]
        },
        "events": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/namespacedId" }
        }
      }
    },
    "operationContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operation", "inputSchema", "outputSchema"],
      "properties": {
        "kind": { "enum": ["query", "action"] },
        "operation": { "$ref": "#/$defs/namespacedId" },
        "inputSchema": { "$ref": "#/$defs/schemaRef" },
        "outputSchema": { "$ref": "#/$defs/schemaRef" }
      }
    },
    "sourcePromotionContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sourceType", "targetSlots"],
      "properties": {
        "kind": { "const": "source-promotion" },
        "sourceType": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,99}$" },
        "targetSlots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,99}$" }
        }
      }
    },
    "rendererProviderContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "renderer", "implementation", "minimumClientVersion", "desktopBehavior",
        "accessibilityContract", "mobileFallback"
      ],
      "properties": {
        "kind": { "const": "renderer-provider" },
        "renderer": { "$ref": "#/$defs/rendererId" },
        "implementation": {
          "type": "string",
          "pattern": "^acorn\\.client\\.[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "maxLength": 160
        },
        "minimumClientVersion": { "$ref": "#/$defs/semver" },
        "desktopBehavior": { "enum": ["embedded", "native-view", "stream-host"] },
        "features": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }
        },
        "accessibilityContract": { "$ref": "#/$defs/schemaRef" },
        "mobileFallback": { "enum": ["semantic", "read-only", "unsupported"] }
      }
    },
    "themeContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tokensPath"],
      "properties": {
        "kind": { "enum": ["theme", "style"] },
        "tokensPath": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
          "maxLength": 240
        }
      }
    },
    "wizardContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "wizard"],
      "properties": {
        "kind": { "const": "wizard" },
        "wizard": { "$ref": "#/$defs/localId" }
      }
    },
    "rendererId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?:/[1-9][0-9]*)$",
      "maxLength": 160
    }
  }
}
