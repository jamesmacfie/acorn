{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acorn.dev/schemas/v2/node-descriptor-v2.schema.json",
  "title": "Acorn V2 Node descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "nodeId", "displayName", "identityFingerprint", "endpoints", "protocols",
    "capabilities", "plugins", "uiArtifacts", "limits", "eventRange", "nodeTime"
  ],
  "properties": {
    "apiVersion": { "const": "acorn.dev/node-descriptor/v2" },
    "nodeId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "identityFingerprint": {
      "type": "string",
      "pattern": "^acorn2:[a-z2-7]{52}$"
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    },
    "protocols": {
      "type": "object",
      "additionalProperties": false,
      "required": ["http", "events"],
      "properties": {
        "http": { "$ref": "#/$defs/versionRange" },
        "events": { "$ref": "#/$defs/versionRange" }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "capability-v2.schema.json" }
    },
    "plugins": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["coordinate", "version", "manifestDigest", "state", "health"],
        "properties": {
          "coordinate": { "$ref": "#/$defs/coordinate" },
          "version": { "$ref": "#/$defs/semver" },
          "manifestDigest": { "$ref": "#/$defs/digest" },
          "state": {
            "enum": [
              "resolving", "awaiting-artifact", "verifying", "awaiting-permission", "staging",
              "awaiting-setup", "activating", "active", "updating", "rolling-back", "disabled",
              "quarantined", "uninstalling", "retained", "purging", "cancelled", "failed"
            ]
          },
          "health": { "enum": ["healthy", "degraded", "unhealthy", "unknown"] }
        }
      }
    },
    "uiArtifacts": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["coordinate", "version", "kind", "digest", "required"],
        "properties": {
          "coordinate": { "$ref": "#/$defs/coordinate" },
          "version": { "$ref": "#/$defs/semver" },
          "kind": { "enum": ["declarative", "bespoke"] },
          "digest": { "$ref": "#/$defs/digest" },
          "required": { "type": "boolean" }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxJsonRequestBytes", "maxQueryResponseBytes", "maxCommands", "maxStreams"],
      "properties": {
        "maxJsonRequestBytes": { "type": "integer", "minimum": 16384, "maximum": 1048576 },
        "maxQueryResponseBytes": { "type": "integer", "minimum": 16384, "maximum": 8388608 },
        "maxCommands": { "type": "integer", "minimum": 1, "maximum": 32 },
        "maxStreams": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    },
    "eventRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oldestSequence", "currentSequence"],
      "properties": {
        "oldestSequence": { "$ref": "#/$defs/decimal" },
        "currentSequence": { "$ref": "#/$defs/decimal" }
      }
    },
    "nodeTime": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "versionRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$" },
        "max": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$" }
      }
    },
    "coordinate": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}/[a-z][a-z0-9-]{1,62}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
