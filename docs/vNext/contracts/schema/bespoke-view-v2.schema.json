{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acorn.dev/schemas/v2/bespoke-view-v2.schema.json",
  "title": "Acorn V2 bespoke view host declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "artifact",
    "entrypoint",
    "minimumTrust",
    "sandboxProfile",
    "hostSurfaces",
    "sizeClasses",
    "viewSessionSchema",
    "bridge",
    "guestFeatures",
    "browserAuthority",
    "fallback"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/localId" },
    "artifact": { "$ref": "#/$defs/localId" },
    "entrypoint": { "$ref": "#/$defs/safePath" },
    "minimumTrust": { "enum": ["community", "acorn-verified"] },
    "sandboxProfile": { "const": "acorn-bespoke-v2" },
    "hostSurfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "fleet-source",
          "workspace-source",
          "task-pane",
          "route",
          "shell-slot",
          "task-slot",
          "settings-page",
          "wizard",
          "agent-tool-renderer"
        ]
      }
    },
    "sizeClasses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["compact", "regular", "wide", "fullscreen"] }
    },
    "viewSessionSchema": { "$ref": "#/$defs/schemaRef" },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "maximumMessageBytes",
        "maximumMessagesPerSecond",
        "methods",
        "events"
      ],
      "properties": {
        "protocolVersion": { "const": "2.0" },
        "maximumMessageBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "maximumMessagesPerSecond": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "methods": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "operation",
              "inputSchema",
              "outputSchema",
              "maximumRequestBytes",
              "maximumResponseBytes",
              "maximumCallsPerMinute",
              "requiresUserGesture",
              "sensitivity"
            ],
            "properties": {
              "id": { "$ref": "#/$defs/localId" },
              "operation": { "$ref": "#/$defs/namespacedId" },
              "inputSchema": { "$ref": "#/$defs/schemaRef" },
              "outputSchema": { "$ref": "#/$defs/schemaRef" },
              "maximumRequestBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              },
              "maximumResponseBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4194304
              },
              "maximumCallsPerMinute": {
                "type": "integer",
                "minimum": 1,
                "maximum": 600
              },
              "requiresUserGesture": { "type": "boolean" },
              "sensitivity": {
                "enum": ["public-metadata", "internal", "sensitive"]
              }
            }
          }
        },
        "events": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "schema",
              "maximumBytes",
              "maximumPerSecond",
              "sensitivity"
            ],
            "properties": {
              "id": { "$ref": "#/$defs/namespacedId" },
              "schema": { "$ref": "#/$defs/schemaRef" },
              "maximumBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              },
              "maximumPerSecond": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120
              },
              "sensitivity": {
                "enum": ["public-metadata", "internal", "sensitive"]
              }
            }
          }
        }
      }
    },
    "guestFeatures": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": ["forms", "canvas-2d", "webgl-host-approved", "media-playback"]
      }
    },
    "browserAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "navigation",
        "storage",
        "serviceWorkers",
        "clipboard",
        "downloads",
        "files",
        "native"
      ],
      "properties": {
        "network": { "const": "deny" },
        "navigation": { "const": "deny" },
        "storage": { "const": "ephemeral-partition-only" },
        "serviceWorkers": { "const": "deny" },
        "clipboard": { "const": "deny" },
        "downloads": { "const": "deny" },
        "files": { "const": "deny" },
        "native": { "const": "deny" }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declarativeContributionId",
        "desktopUnavailable",
        "mobile"
      ],
      "properties": {
        "declarativeContributionId": { "$ref": "#/$defs/localId" },
        "desktopUnavailable": {
          "enum": ["semantic", "read-only", "unsupported-screen"]
        },
        "mobile": { "enum": ["semantic", "read-only", "unsupported"] }
      }
    }
  },
  "$defs": {
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "namespacedId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:[.-][a-z0-9-]+)+\\.v[1-9][0-9]*$",
      "maxLength": 200
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "maxLength": 240
    },
    "schemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest"],
      "properties": {
        "uri": { "type": "string", "format": "uri", "maxLength": 500 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
