{
  "apiVersion": "acorn.dev/plugin/v2",
  "coordinate": "acme/docker-watch",
  "version": "2.1.0",
  "displayName": "Docker Watch",
  "description": "Publishes normalized Docker state from an OS-sandboxed native worker.",
  "license": "Apache-2.0",
  "compatibility": {
    "nodeProtocol": { "min": "2.0", "max": "2.0" },
    "clientProtocol": { "min": "2.0", "max": "2.0" },
    "rendererCapabilities": [
      {
        "kind": "renderer-advertisement",
        "id": "acorn.collection/2",
        "revision": 0,
        "required": true,
        "reason": "Render normalized container state.",
        "constraints": {}
      }
    ]
  },
  "artifacts": [
    {
      "id": "node-darwin-arm64",
      "kind": "runtime",
      "target": "node",
      "runtime": "native-process",
      "digest": "sha256:2020202020202020202020202020202020202020202020202020202020202020",
      "size": 8388608,
      "mediaType": "application/octet-stream",
      "path": "runtime/darwin-arm64/docker-watch",
      "platform": "darwin",
      "architecture": "arm64",
      "entrypoint": "docker-watch"
    },
    {
      "id": "views",
      "kind": "ui",
      "target": "client",
      "runtime": "declarative",
      "digest": "sha256:2121212121212121212121212121212121212121212121212121212121212121",
      "size": 16384,
      "mediaType": "application/vnd.acorn.declarative-ui+json",
      "path": "ui/docker-watch.json",
      "platform": "any",
      "architecture": "any",
      "entrypoint": "docker-watch.json"
    },
    {
      "id": "schemas",
      "kind": "schemas",
      "target": "shared",
      "runtime": "none",
      "digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
      "size": 24576,
      "mediaType": "application/schema+json",
      "path": "schemas/bundle.json",
      "platform": "any",
      "architecture": "any",
      "entrypoint": "bundle.json"
    }
  ],
  "contributions": [
    {
      "id": "docker-state",
      "type": "task-pane",
      "artifact": "views",
      "capabilityVersion": "2.0",
      "label": "Docker state",
      "description": "Show task containers.",
      "order": 70,
      "when": null,
      "requires": {
        "dependencies": [],
        "grants": ["dev.acme.docker-watch.inspect.v1"],
        "rendererCapabilities": ["acorn.collection/2"],
        "rendererNodes": ["acorn.table/2"]
      },
      "fallback": {
        "kind": "unsupported",
        "desktop": "placeholder",
        "mobile": "read-only",
        "reason": "Collection rendering is unavailable."
      },
      "definition": {
        "kind": "task-pane",
        "icon": "container",
        "view": "docker-state-view",
        "minimumWidth": 320,
        "retention": "session"
      }
    },
    {
      "id": "docker-worker",
      "type": "background-worker",
      "artifact": "node-darwin-arm64",
      "capabilityVersion": "2.0",
      "label": "Docker event worker",
      "description": "Observe the Docker event stream.",
      "order": 0,
      "when": null,
      "requires": {
        "dependencies": [],
        "grants": ["dev.acme.docker-watch.events.v1"],
        "rendererCapabilities": [],
        "rendererNodes": []
      },
      "fallback": {
        "kind": "unsupported",
        "desktop": "disabled",
        "mobile": "unsupported",
        "reason": "Native Docker worker is unavailable."
      },
      "definition": {
        "kind": "background-worker",
        "worker": {
          "apiVersion": "acorn.dev/worker/v2",
          "id": "docker-events",
          "mode": "resident",
          "operation": "dev.acme.docker-watch.worker.run.v1",
          "startup": "installation-active",
          "readinessTimeoutMs": 10000,
          "heartbeatIntervalMs": 5000,
          "heartbeatTimeoutMs": 15000,
          "drainTimeoutMs": 10000,
          "restart": "on-failure",
          "backoff": {
            "initialMs": 500,
            "maximumMs": 60000,
            "multiplier": 2,
            "jitterPercent": 20,
            "maxConsecutiveFailures": 5
          },
          "checkpoint": {
            "enabled": true,
            "maximumBytes": 4096,
            "schema": {
              "uri": "https://acorn.dev/examples/docker-watch/checkpoint-v1.json",
              "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            }
          },
          "resources": {
            "memoryMiB": 128,
            "cpuMillisPerMinute": 10000,
            "handles": 128,
            "outputBytesPerMinute": 1048576
          }
        }
      }
    }
  ],
  "bespokeViews": [],
  "operations": [],
  "streams": [],
  "capabilities": {
    "requested": [
      {
        "kind": "permission-request",
        "id": "acorn.docker.events/1",
        "revision": 0,
        "scope": "workspace",
        "required": true,
        "reason": "Read Docker state for workspace-associated projects.",
        "constraints": {
          "family": "docker",
          "operations": ["events", "inspect"],
          "composeSnapshotDigest": null,
          "highRiskEffects": ["none"]
        }
      }
    ],
    "exported": []
  },
  "dependencies": [],
  "events": {
    "publishes": [
      {
        "type": "dev.acme.docker-watch.container-state-changed.v1",
        "version": "1.0.0",
        "schema": {
          "uri": "urn:acorn-plugin:acme:docker-watch:schema:container-state-changed-v1",
          "digest": "sha256:2323232323232323232323232323232323232323232323232323232323232323"
        }
      }
    ],
    "subscribes": []
  },
  "settings": [
    {
      "id": "project-matchers",
      "schema": {
        "uri": "urn:acorn-plugin:acme:docker-watch:schema:settings-v1",
        "digest": "sha256:2424242424242424242424242424242424242424242424242424242424242424"
      },
      "scopes": ["workspace", "repository"],
      "containsSecrets": false
    }
  ],
  "wizards": [],
  "storage": {
    "schemaVersion": 1,
    "quotaBytes": 104857600,
    "backup": "exclude-cache",
    "migrations": [
      {
        "from": 0,
        "to": 1,
        "digest": "sha256:2525252525252525252525252525252525252525252525252525252525252525",
        "reversible": true
      }
    ]
  },
  "health": {
    "startupTimeoutMs": 10000,
    "checkIntervalMs": 15000,
    "failureThreshold": 3
  },
  "provenance": {
    "publisherKeyId": "acme-native-release-2026",
    "manifestDigest": "sha256:2626262626262626262626262626262626262626262626262626262626262626",
    "signature": "CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC",
    "sbomDigest": "sha256:2727272727272727272727272727272727272727272727272727272727272727",
    "transparencyEntry": "https://transparency.acorn.dev/entries/native-123456"
  }
}
