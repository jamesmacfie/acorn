{
  "id": "unsafe-link",
  "type": "navigation-intent",
  "artifact": "views",
  "capabilityVersion": "2.0",
  "label": "Unsafe regex link",
  "description": "Must be rejected because navigation templates are not regular expressions.",
  "order": 1,
  "when": null,
  "requires": {
    "dependencies": [],
    "grants": [],
    "rendererCapabilities": [],
    "rendererNodes": []
  },
  "fallback": {
    "kind": "unsupported",
    "desktop": "disabled",
    "mobile": "unsupported",
    "reason": "Unsafe navigation input is unavailable."
  },
  "definition": {
    "kind": "navigation-intent",
    "patterns": [
      {
        "template": "^https?://(.+)+$",
        "queryPolicy": {
          "mode": "reject",
          "allowedKeys": [],
          "captures": {}
        }
      }
    ],
    "destination": {
      "kind": "client-command",
      "command": "dev.acme.navigation.open.v1",
      "inputMapping": {
        "target": "$capture.target"
      }
    },
    "externalPolicy": "internal-only",
    "collisionPolicy": "reject-install"
  }
}
