{
  "id": "mission-board",
  "artifact": "bespoke-ui",
  "entrypoint": "ui/index.html",
  "minimumTrust": "community",
  "sandboxProfile": "acorn-bespoke-v2",
  "hostSurfaces": ["task-pane"],
  "sizeClasses": ["regular", "wide"],
  "viewSessionSchema": {
    "uri": "https://plugins.example.test/schemas/mission-board-session-v1.json",
    "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
  },
  "bridge": {
    "protocolVersion": "2.0",
    "maximumMessageBytes": 65536,
    "maximumMessagesPerSecond": 30,
    "methods": [
      {
        "id": "open-task",
        "operation": "dev.acme.board.task.open.v1",
        "inputSchema": {
          "uri": "https://plugins.example.test/schemas/open-task-input-v1.json",
          "digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222"
        },
        "outputSchema": {
          "uri": "https://plugins.example.test/schemas/open-task-output-v1.json",
          "digest": "sha256:3333333333333333333333333333333333333333333333333333333333333333"
        },
        "maximumRequestBytes": 4096,
        "maximumResponseBytes": 4096,
        "maximumCallsPerMinute": 120,
        "requiresUserGesture": true,
        "sensitivity": "internal"
      }
    ],
    "events": [
      {
        "id": "dev.acme.board.view.updated.v1",
        "schema": {
          "uri": "https://plugins.example.test/schemas/view-updated-v1.json",
          "digest": "sha256:4444444444444444444444444444444444444444444444444444444444444444"
        },
        "maximumBytes": 16384,
        "maximumPerSecond": 10,
        "sensitivity": "internal"
      }
    ]
  },
  "guestFeatures": ["forms", "canvas-2d"],
  "browserAuthority": {
    "network": "deny",
    "navigation": "deny",
    "storage": "ephemeral-partition-only",
    "serviceWorkers": "deny",
    "clipboard": "deny",
    "downloads": "deny",
    "files": "deny",
    "native": "deny"
  },
  "fallback": {
    "declarativeContributionId": "mission-board-semantic",
    "desktopUnavailable": "semantic",
    "mobile": "semantic"
  }
}
