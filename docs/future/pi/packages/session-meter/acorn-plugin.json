{
  "$schema": "https://acorn.sh/schemas/acorn-plugin.schema.json",
  "id": "acorn-session-meter",
  "name": "Session meter",
  "version": "0.1.0",
  "baseline": "acorn-1",
  "apiVersion": "3",
  "node": "./node.js",
  "client": "./client.js",
  "requires": { "plugins": [{ "id": "agents" }] },
  "permissions": {
    "api": [],
    "events": ["plugin:agents:activity"],
    "node": {
      "core": [],
      "capabilities": ["agents.sessions", "agents.activity.v1", "agents.sessionControl"],
      "secrets": false,
      "exec": false,
      "net": []
    }
  },
  "contributions": {
    "frames": [
      {
        "target": "pane",
        "id": "meter",
        "label": "Session meter",
        "glyph": "gauge",
        "layout": "single",
        "regions": { "body": { "kind": "remote", "entry": "meter" } }
      }
    ],
    "commands": [
      {
        "id": "cycle-effort",
        "title": "Session meter: cycle reasoning effort",
        "keywords": ["effort", "reasoning", "thinking"],
        "kind": "action",
        "action": { "verb": "surfaceAction", "surface": "meter" }
      }
    ]
  }
}
