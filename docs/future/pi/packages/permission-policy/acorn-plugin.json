{
  "$schema": "https://acorn.sh/schemas/acorn-plugin.schema.json",
  "id": "acorn-permission-policy",
  "name": "Permission policy",
  "version": "0.1.0",
  "baseline": "acorn-1",
  "apiVersion": "3",
  "node": "./node.js",
  "permissions": {
    "api": [],
    "events": [],
    "node": { "core": [], "capabilities": [], "secrets": false, "exec": false, "net": [] }
  },
  "contributions": {
    "extensions": [
      {
        "id": "rules",
        "point": "agents:before-permission",
        "label": "run a tool the agent asks permission for",
        "route": "/v1/p/acorn-permission-policy/before-permission",
        "mode": "veto"
      }
    ]
  }
}
