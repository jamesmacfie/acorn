{
  "$schema": "https://acorn.sh/schemas/acorn-plugin.schema.json",
  "id": "hello-pane",
  "name": "Hello pane",
  "version": "1.0.0",
  "baseline": "acorn-1",
  "apiVersion": "5",
  "node": "./node/index.js",
  "client": "./client.js",
  "permissions": {
    "api": [],
    "events": [],
    "node": {
      "core": [
        "tasks"
      ],
      "capabilities": [],
      "secrets": false,
      "exec": false,
      "net": []
    }
  },
  "contributions": {
    "frames": [
      {
        "target": "pane",
        "id": "hello-pane",
        "label": "Hello pane",
        "glyph": "puzzle",
        "order": 800,
        "layout": "single",
        "regions": {
          "body": {
            "kind": "remote",
            "entry": "pane"
          }
        }
      }
    ],
    "commands": [
      {
        "id": "open",
        "kind": "action",
        "title": "Open Hello pane",
        "category": "pane",
        "action": {
          "verb": "openPane",
          "pane": "hello-pane"
        }
      }
    ]
  }
}
