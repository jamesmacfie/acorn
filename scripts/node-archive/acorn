#!/bin/sh
# Runs acorn on the archive's own Node.js runtime, from any working directory.
set -e
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

# Without it, acorn falls back to the desktop app's data root, which this Node must not share.
if [ -z "$ACORN_DATA_DIR" ]; then
  echo "acorn: run this archive's install.sh, which gives the acorn command a data folder, or set ACORN_DATA_DIR to a folder for the Node's data." >&2
  exit 1
fi

exec "$root/runtime/node" --disable-warning=ExperimentalWarning "$root/lib/bin/acorn.mjs" "$@"
